-- ==========================================
-- العم ثامر | Protected Wrapper Loader
-- ==========================================

local TARGET_URL =
    "https://raw.githubusercontent.com/ggtughui-hub/mm/refs/heads/main/ac"

-- جلب السورس
local function FetchSource(url)
    local success, result = pcall(function()
        return game:HttpGet(url)
    end)

    if not success or type(result) ~= "string" or #result == 0 then
        return nil, "فشل جلب السورس"
    end

    return result
end

-- Wrapper
local function Wrapper(source)
    local env = getfenv and getfenv() or _ENV

    local success, compiled = pcall(function()
        return loadstring(source)
    end)

    if not success or type(compiled) ~= "function" then
        return false, "فشل تحويل السورس"
    end

    if setfenv then
        pcall(function()
            setfenv(compiled, env)
        end)
    end

    local executed, result = pcall(compiled)

    if not executed then
        return false, result
    end

    return true, result
end

-- ==========================================
-- العم ثامر Wrapper
-- ==========================================

local source, fetchError = FetchSource(TARGET_URL)

if not source then
    warn("[Wrapper] " .. tostring(fetchError))
    return
end

local success, result = Wrapper(source)

-- إزالة المراجع بعد انتهاء التنفيذ
source = nil
collectgarbage("collect")

if not success then
    warn("[Wrapper] Execution failed:", result)
end
