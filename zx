local function getMainSize(isMobile)
    local vp = Camera.ViewportSize
    if isMobile then
        local w = math.clamp(vp.X * 0.94, 280, 370)
        local h = math.clamp(vp.Y * 0.55, 340, 460)
        return UDim2.fromOffset(w, h)
    else
        local w = math.clamp(vp.X * 0.40, 560, 700)
        local h = math.clamp(vp.Y * 0.60, 400, 500)
        return UDim2.fromOffset(w, h)
    end
end

