local function exactFishName(name)
    if not name then return nil end
    name = tostring(name)
    if fishList[name] ~= nil then
        return name
    end
    return nil
end

local function parseFishNameFromText(text)
    if not text or text == "" then return nil end
    local raw = tostring(text)
    local exact = exactFishName(raw)
    if exact then return exact end
    local inside = string.match(raw, "%(([^%)]+)%)")
    if inside then
        inside = string.gsub(inside, "^%s+", "")
        inside = string.gsub(inside, "%s+$", "")
        exact = exactFishName(inside)
        if exact then return exact end
    end
    return nil
end

local function fishNameFromModel(inst)
    local cur = inst
    for _ = 1, 8 do
        if not cur then break end
        local exact = exactFishName(cur.Name)
        if exact then return exact end
        if cur:IsA("Model") or cur:IsA("Folder") then
            exact = exactFishName(cur.Name)
            if exact then return exact end
        end
        cur = cur.Parent
    end
    return nil
end

local function readLabelsNear(inst)
    if not inst then return nil end
    local fromModel = fishNameFromModel(inst)
    if fromModel then return fromModel end
    local parsed = parseFishNameFromText(inst.Name)
    if parsed then return parsed end
    if inst:IsA("StringValue") or inst:IsA("ObjectValue") then
        parsed = parseFishNameFromText(tostring(inst.Value))
        if parsed then return parsed end
    end
    for _, attrVal in pairs(inst:GetAttributes()) do
        parsed = parseFishNameFromText(tostring(attrVal))
        if parsed then return parsed end
    end
    if inst:IsA("BillboardGui") or inst:IsA("SurfaceGui") or inst:IsA("TextLabel") or inst:IsA("TextButton") then
        local t = inst.Text
        if t then
            parsed = parseFishNameFromText(t)
            if parsed then return parsed end
        end
    end
    for _, child in ipairs(inst:GetChildren()) do
        if child:IsA("BillboardGui") or child:IsA("SurfaceGui") then
            for _, lab in ipairs(child:GetChildren()) do
                if lab:IsA("TextLabel") or lab:IsA("TextButton") then
                    parsed = parseFishNameFromText(lab.Text)
                    if parsed then return parsed end
                end
            end
        elseif child:IsA("TextLabel") or child:IsA("TextButton") then
            parsed = parseFishNameFromText(child.Text)
            if parsed then return parsed end
        end
    end
    return nil
end

