local function getHookedFishName()
    local function isUnder(inst, ancestor)
        local cur = inst
        while cur do
            if cur == ancestor then return true end
            cur = cur.Parent
        end
        return false
    end

    local function otherEnd(obj, rod)
        local ends = {}
        for _, prop in ipairs({"Attachment0", "Attachment1", "Part0", "Part1"}) do
            local ok, val = pcall(function()
                return obj[prop]
            end)
            if ok and typeof(val) == "Instance" then
                if val:IsA("Attachment") then
                    table.insert(ends, val.Parent)
                else
                    table.insert(ends, val)
                end
            end
        end
        for _, node in ipairs(ends) do
            if node and not isUnder(node, rod) then
                return node
            end
        end
        return ends[2]
    end

    local function scanForFish(inst, depth)
        if not inst then return nil end
        depth = depth or 0
        local n = readLabelsNear(inst)
        if n then return n end
        if depth >= 3 then return nil end
        for _, child in ipairs(inst:GetChildren()) do
            n = scanForFish(child, depth + 1)
            if n then return n end
        end
        if inst.Parent and inst.Parent ~= Workspace and not inst.Parent:IsA("Tool") then
            return readLabelsNear(inst.Parent)
        end
        return nil
    end

    local function fromRodLine(rod)
        if not rod then return nil end
        local found = nil
        pcall(function()
            local n = scanForFish(rod, 0)
            if n then found = n return end
            for _, v in ipairs(rod:GetDescendants()) do
                n = readLabelsNear(v)
                if n then found = n return end
                if v:IsA("Beam") or v:IsA("Trail")
                    or v:IsA("RopeConstraint") or v:IsA("RodConstraint")
                    or v:IsA("SpringConstraint") then
                    local other = otherEnd(v, rod)
                    if other then
                        n = scanForFish(other, 0)
                        if n then found = n return end
                        local cur = other
                        for _ = 1, 6 do
                            if not cur then break end
                            n = readLabelsNear(cur)
                            if n then found = n return end
                            cur = cur.Parent
                            if not cur or cur == Workspace or cur:IsA("Tool") then break end
                        end
                    end
                end
            end
        end)
        return found
    end

    local ok, result = pcall(function()
        local rod = GetRodInHand() or GetRodTool()
        if not rod then return nil end
        return fromRodLine(rod)
    end)
    if ok then return result end
    return nil
end

