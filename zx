local TARGET_URL = "https://raw.githubusercontent.com/ggtughui-hub/mm/refs/heads/main/ac"

local function Fetch()
    local ok, src = pcall(function()
        return game:HttpGet(TARGET_URL)
    end)

    if not ok or type(src) ~= "string" or src == "" then
        return nil
    end

    return src
end

-- العم ثامر Wrapper
local function Wrapper(source)
    local environment = getfenv and getfenv() or _ENV

    local ok, compiled = pcall(loadstring, source)
    if not ok or type(compiled) ~= "function" then
        return false, "Compilation failed"
    end

    if setfenv then
        pcall(setfenv, compiled, environment)
    end

    return pcall(compiled)
end

local source = Fetch()

if source then
    local success, err = Wrapper(source)

    -- التخلص من المرجع بعد التنفيذ
    source = nil

    if not success then
        warn("Wrapper error:", err)
    end
end
