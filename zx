local function forceEquipRodInHand()
    local Character = LocalPlayer.Character
    if not Character then return nil end
    local Humanoid = Character:FindFirstChildOfClass("Humanoid")
    local Backpack = LocalPlayer:FindFirstChild("Backpack")
    if not Humanoid then return nil end

    local rodUid, _, actualRodName = getRodAndBaitUid()
    local Net = require(ReplicatedStorage.Modules.Core.Net)

    local held = Character:FindFirstChildOfClass("Tool")
    if held and not isRodTool(held) then
        pcall(function() Humanoid:UnequipTools() end)
        task.wait(0.05)
    end

    local rodTool = nil
    if actualRodName then
        rodTool = Character:FindFirstChild(actualRodName) or (Backpack and Backpack:FindFirstChild(actualRodName))
    end
    if not rodTool then
        rodTool = GetRodTool()
    end
    if not rodTool and rodUid then
        pcall(function() Net.get("toggle_equip_item", tostring(rodUid)) end)
        task.wait(0.08)
        rodTool = GetRodTool()
        if actualRodName then
            rodTool = rodTool or Character:FindFirstChild(actualRodName) or (Backpack and Backpack:FindFirstChild(actualRodName))
        end
    end
    if not rodTool then
        return nil
    end

    if rodTool.Parent ~= Character then
        if rodTool.Parent == Backpack then
            Humanoid:EquipTool(rodTool)
            task.wait(0.08)
        end
    end

    local inHand = Character:FindFirstChildOfClass("Tool")
    if inHand and isRodTool(inHand) then
        return inHand
    end
    if rodTool.Parent == Backpack or rodTool.Parent == Character then
        pcall(function() Humanoid:UnequipTools() end)
        task.wait(0.04)
        if rodTool.Parent == Backpack then
            Humanoid:EquipTool(rodTool)
            task.wait(0.08)
        end
        inHand = Character:FindFirstChildOfClass("Tool")
        if inHand and isRodTool(inHand) then
            return inHand
        end
    end
    return nil
end

