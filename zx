                    TextSize = 14,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    Parent = row,
                })
                local loadBtn = new("TextButton", {
                    Size = UDim2.fromOffset(55, 28),
                    Position = UDim2.new(1, -120, 0.5, 0),
                    AnchorPoint = Vector2.new(0, 0.5),
