                    AutoButtonColor = false,
                    Font = FONT_MEDIUM,
                    Text = "Load",
                    TextColor3 = THEME.Text,
                    TextSize = 12,
                    Parent = row,
                })
                new("UICorner", {CornerRadius = UDim.new(0, 6), Parent = loadBtn})
                local delBtn = new("TextButton", {
                    Size = UDim2.fromOffset(55, 28),
                    Position = UDim2.new(1, -58, 0.5, 0),
                    AnchorPoint = Vector2.new(0, 0.5),
                    BackgroundColor3 = Color3.fromRGB(180, 40, 40),
                    AutoButtonColor = false,
                    Font = FONT_MEDIUM,
                    Text = "Delete",
                    TextColor3 = THEME.Text,
                    TextSize = 12,
                    Parent = row,
                })
                new("UICorner", {CornerRadius = UDim.new(0, 6), Parent = delBtn})
                loadBtn.MouseButton1Click:Connect(function()
                    local cfg = savedConfigs[name]
                    if cfg then
                        applySettings(cfg)
                        showEffect("✅ تم تحميل: " .. name, "success")
                    end
                end)
                delBtn.MouseButton1Click:Connect(function()
                    savedConfigs[name] = nil
                    saveConfigsToFile()
                    refreshConfigList()
                    showEffect("🗑️ تم حذف: " .. name, "error")
                end)
            end
        end

        loadConfigsFromFile()
        refreshConfigList()

        saveBtn.MouseButton1Click:Connect(function()
            local name = nameBox.Text
            if not name or #name < 1 then
                showEffect("❌ اكتب اسم للكونفيغ أولاً", "error")
