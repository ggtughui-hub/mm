        local function applyScale(value)
            currentScale = math.clamp(value, SCALE_MIN, SCALE_MAX)
            MainUIScale.Scale = currentScale
            local percent = math.floor(currentScale * 100 + 0.5)
            scaleLabel.Text = "الحجم الحالي: " .. percent .. "%"
            local pct = (currentScale - SCALE_MIN) / (SCALE_MAX - SCALE_MIN)
            sliderFill.Size = UDim2.new(pct, 0, 1, 0)
            sliderKnob.Position = UDim2.new(pct, -10, 0.5, 0)
        end
