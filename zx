    })
    new("UICorner", {CornerRadius = UDim.new(1, 0), Parent = dropKnob})
    new("UIStroke", {Color = THEME.Accent, Thickness = 2, Parent = dropKnob})

    local DROP_MIN, DROP_MAX = 0, 15
    local slidingDrop = false

    local function updateDropSlider(value)
        local v = math.clamp(math.floor(value + 0.5), DROP_MIN, DROP_MAX)
        dropDelay = v
        local percent = (v - DROP_MIN) / (DROP_MAX - DROP_MIN)
        dropFill.Size = UDim2.new(percent, 0, 1, 0)
        dropKnob.Position = UDim2.new(percent, -9, 0.5, 0)
        dropDelayLabel.Text = "تأخير الرمي: " .. v .. "s"
    end
    updateDropSlider(0)

    local function getDropFromX(x)
        local absPos = dropTrack.AbsolutePosition.X
        local absSize = dropTrack.AbsoluteSize.X
        if absSize <= 0 then return dropDelay end
        local percent = math.clamp((x - absPos) / absSize, 0, 1)
        return DROP_MIN + percent * (DROP_MAX - DROP_MIN)
    end

    dropTrack.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            slidingDrop = true
            slidingAny = true
            updateDropSlider(getDropFromX(input.Position.X))
        end
    end)
    dropKnob.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            slidingDrop = true
            slidingAny = true
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if slidingDrop and (input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch) then
            updateDropSlider(getDropFromX(input.Position.X))
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
