        local function loadConfigsFromFile()
            savedConfigs = {}
            if isfile and readfile and isfile(CONFIG_FILE) then
                local ok, data = pcall(function()
                    return HttpService:JSONDecode(readfile(CONFIG_FILE))
                end)
                if ok and type(data) == "table" then
                    savedConfigs = data
                end
            end
        end

        local function saveConfigsToFile()
            if writefile then
                pcall(function()
                    writefile(CONFIG_FILE, HttpService:JSONEncode(savedConfigs))
                end)
            end
        end

        local function refreshConfigList()
            for _, child in ipairs(configScroll:GetChildren()) do
                if child:IsA("Frame") then child:Destroy() end
            end
            local names = {}
            for name in pairs(savedConfigs) do table.insert(names, name) end
            table.sort(names)
            if #names == 0 then
                new("TextLabel", {
                    Size = UDim2.new(1, -4, 0, 36),
                    BackgroundTransparency = 1,
                    Font = FONT_REGULAR,
                    Text = "ما في كونفيجات محفوظة بعد...",
