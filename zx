local function GetRodTool()
    local Character = LocalPlayer.Character
    local Backpack = LocalPlayer:FindFirstChild("Backpack")
    local rodNames = {"FishingRodUltimate", "FishingRodAdvanced", "FishingRodPro", "FishingRodRegular"}

    local function looksLikeRod(inst)
        if not inst or not inst:IsA("Tool") then return false end
        local n = string.lower(tostring(inst.Name))
        if string.find(n, "rod") or string.find(n, "fish") or string.find(n, "سنار") then
            return true
        end
        for _, name in ipairs(rodNames) do
            if inst.Name == name then return true end
        end
        return false
    end

    if Character then
        local equipped = Character:FindFirstChildOfClass("Tool")
        if equipped then return equipped end
        for _, name in ipairs(rodNames) do
            local tool = Character:FindFirstChild(name)
            if tool then return tool end
        end
        for _, child in ipairs(Character:GetChildren()) do
            if looksLikeRod(child) then return child end
        end
    end

    if Backpack then
        for _, name in ipairs(rodNames) do
            local tool = Backpack:FindFirstChild(name)
            if tool then return tool end
        end
        for _, child in ipairs(Backpack:GetChildren()) do
            if looksLikeRod(child) then return child end
        end
    end
    return nil
end

