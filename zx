                    TextSize = 13,
                    Parent = configScroll,
                })
                return
            end
            for _, name in ipairs(names) do
                local row = new("Frame", {
                    Size = UDim2.new(1, -4, 0, 42),
                    BackgroundColor3 = THEME.PanelLight,
                    BorderSizePixel = 0,
                    Parent = configScroll,
                })
