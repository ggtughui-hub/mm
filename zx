function advanceSpotAfterCatch()
    local enabled = getEnabledSpotList()
    multiSpotEnabled = #enabled > 1
    if not multiSpotEnabled then return end
    currentSpotCatches = currentSpotCatches + 1
    if currentSpotCatches >= catchesPerSpot then
        currentSpotCatches = 0
        local prev = currentSpotIndex
        local idxInEnabled = 1
        for i, spot in ipairs(enabled) do
