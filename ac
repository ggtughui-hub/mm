-- ==========================================
function Sf:IsInventoryFull()
    local maxSlots = 20
    local success, result = pcall(function()
        return Net.send("get_max_inventory_space")
    end)
    
    if success and result then
        if type(result) == "table" then
            -- نجيب الحد الأقصى الحقيقي
            maxSlots = result.max or result.limit or result.maxSlots or result.hand or result[1] or 20
        elseif type(result) == "number" then
            maxSlots = result
        end
    end
    
    -- إذا maxSlots أقل من 10، نجرب Get كاحتياط
    if maxSlots < 10 then
        local success2, result2 = pcall(function()
            return Net.get("get_max_inventory_space")
        end)
        if success2 and result2 then
            if type(result2) == "number" and result2 > 10 then
                maxSlots = result2
            elseif type(result2) == "table" then
                maxSlots = result2.max or result2.limit or result2.maxSlots or result2.hand or 20
            end
        end
    end
    
    if maxSlots <= 0 then maxSlots = 20 end
    
    local currentItems = 0
    local Items = PlayerGui:FindFirstChild("Items")
    if Items then
        local Holding = Items:FindFirstChild("ItemsHolder") and Items.ItemsHolder:FindFirstChild("ItemsScrollingFrame")
        if Holding then
            for _, v in pairs(Holding:GetChildren()) do
                if v.Name ~= 'Folder' and v.Name ~= 'UIGridLayout' and v.Name ~= "ItemTemplate" then
                    currentItems = currentItems + 1
                end
            end
        end
    end
    
    print("📦 المخزون: " .. currentItems .. "/" .. maxSlots)
    
    -- ✅ يبيع فقط إذا currentItems >= maxSlots (فل بالكامل)
    local isFull = currentItems >= maxSlots
    return isFull, currentItems, maxSlots
end

