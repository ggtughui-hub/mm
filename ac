local function PurchaseExactBait(targetBait, amount)
    local currentBaitCount = 0
    local Items = PlayerGui:FindFirstChild("Items")
    if Items then
        local Holding = Items:FindFirstChild("ItemsHolder") and Items.ItemsHolder:FindFirstChild("ItemsScrollingFrame")
        if Holding then
            for _, v in pairs(Holding:GetChildren()) do
                if v.Name ~= 'Folder' and v.Name ~= 'UIGridLayout' and v.Name ~= "ItemTemplate" then
                    local itemName = v:FindFirstChild("ItemName")
                    if itemName and itemName.Text then
                        local t = string.lower(itemName.Text)
                        if string.find(t, string.lower(targetBait)) then
                            currentBaitCount = currentBaitCount + 1
                        end
                    end
                end
            end
        end
    end
    
    if currentBaitCount >= amount then
        return true
    end
    
    local needed = amount - currentBaitCount
    local purchased = 0
    local maxAttempts = needed + 1
    
    while purchased < needed and purchased < maxAttempts do
        local currentCount = 0
        local Items2 = PlayerGui:FindFirstChild("Items")
        if Items2 then
            local Holding2 = Items2:FindFirstChild("ItemsHolder") and Items2.ItemsHolder:FindFirstChild("ItemsScrollingFrame")
            if Holding2 then
                for _, v in pairs(Holding2:GetChildren()) do
                    if v.Name ~= 'Folder' and v.Name ~= 'UIGridLayout' and v.Name ~= "ItemTemplate" then
                        local itemName = v:FindFirstChild("ItemName")
                        if itemName and itemName.Text then
                            local t = string.lower(itemName.Text)
                            if string.find(t, string.lower(targetBait)) then
                                currentCount = currentCount + 1
                            end
                        end
                    end
                end
            end
        end
        
        if currentCount >= amount then
            return true
        end
        
        Net.get("purchase_consumable", workspace:WaitForChild("ShopZone_Hardware"), targetBait)
        purchased = purchased + 1
        task.wait(0.2)
    end
    
    return true
end

