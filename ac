                                    if Config.Paused then break end

                                    local sliderGui = PlayerGui:FindFirstChild("SliderMinigame")
                                    if sliderGui then
                                        local frame = sliderGui:FindFirstChildOfClass("Frame")
                                        if frame and frame.Visible then
                                            progressBarVisible = true
                                            break
                                        end
                                    end
                                end

                                if progressBarVisible then
                                    task.wait(1)

                                    local currentFish = GetFishNamesFromInventory()
                                    local newFish = GetNewFish(LastFishCount, currentFish)
                                    if #newFish > 0 then
                                        fishCaught = newFish[#newFish]
                                        print("🐟 تم صيد: " .. fishCaught)

                                        local Items3 = PlayerGui:FindFirstChild("Items")
                                        if Items3 then
                                            local Holding3 = Items3:FindFirstChild("ItemsHolder") and Items3.ItemsHolder:FindFirstChild("ItemsScrollingFrame")
                                            if Holding3 then
                                                for _, v in pairs(Holding3:GetChildren()) do
                                                    if v.Name ~= 'Folder' and v.Name ~= 'UIGridLayout' and v.Name ~= "ItemTemplate" then
                                                        local itemName = v:FindFirstChild("ItemName")
                                                        if itemName and itemName.Text == fishCaught then
                                                            local itemType = v:GetAttribute("ItemType")
                                                            if itemType and string.lower(tostring(itemType)) == "fish" then
                                                                fishUID = v.Name
                                                                break
                                                            end
                                                        end
                                                    end
                                                end
                                            end
                                        end
                                    end

                                    if fishCaught and (fishCaught == "Marlin" or fishCaught == "Sailfish") then
                                        print("⭐ تم صيد سمكة نادرة: " .. fishCaught)

                                        if fishUID then
                                            print("🗑️ رمي السمكة النادرة في المكان المحدد...")

                                            local dropPos = Vector3.new(77.815, 252.054, 788.636)
                                            Sf:WalkTo(dropPos, Config.AutoFishing)
                                            task.wait(0.5)

                                            local Event = game:GetService("ReplicatedStorage").Remotes.Send
                                            Event:FireServer("drop_item", fishUID, 1)
                                            print("✅ تم رمي " .. fishCaught)

                                            Sf:WalkTo(fishingSpot, Config.AutoFishing)
                                            task.wait(0.5)
                                        end
                                    else
                                        print("🔄 سمكة عادية - إعادة الرمي...")

                                        if rodTool and rodTool.Parent == Character then
                                            Humanoid:UnequipTools()
                                            task.wait(0.2)
                                        end

                                        if rodTool then
                                            Humanoid:EquipTool(rodTool)
                                            task.wait(0.2)
                                        end

                                        Net.get("throw_rod", rodTool, castPos)
                                        print("🎣 إعادة الرمي...")
                                    end
                                end
                            end
                        else
                            break
                        end
                        task.wait(0.1)
                    end
                end
            end)
        else
            Sf:ForceStop()
        end
    end,
})

local autoEquipActive = false
local fakeTools = {}
local function clearFakeTools()
    for _, obj in ipairs(fakeTools) do if obj then obj:Destroy() end end
    fakeTools = {}
end
FishingTab:Toggle({
    Title = "Auto Equip FishingRod", Desc = "تجهيز تلقائي دائم للسنارة", Value = false,
    Flag = "AutoEquipRod",
    Callback = function(v)
        autoEquipActive = v
        if not autoEquipActive then clearFakeTools() end
        if autoEquipActive then
            task.spawn(function()
                while autoEquipActive do
                    local character = Client.Character or Client.CharacterAdded:Wait()
                    local backpack = Client:FindFirstChild("Backpack")
