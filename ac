function Sf:GetBankMoney()
    local moneyData = require(RS.Modules.Core.Data).money
    if moneyData and moneyData.bank then
        return moneyData.bank
    end
    return 0
end

local function FindClosestAvailableATM()
    local atmFolder = workspace:FindFirstChild("Map") and workspace.Map:FindFirstChild("Props") and workspace.Map.Props:FindFirstChild("ATMs")
    if not atmFolder then
        return nil
    end
    local closest, shortest = nil, math.huge
    for _, atm in pairs(atmFolder:GetChildren()) do
        if atm.Name == "ATM" and atm:IsA("Model") then
            local keys = {}
            for k in pairs(atm:GetAttributes()) do
                table.insert(keys, k)
            end
            table.sort(keys)
            if keys[3] and atm:GetAttribute(keys[3]) == false then
                local pos = atm:FindFirstChild("Area") and atm.Area.Position or atm.PrimaryPart and atm.PrimaryPart.Position
                if pos then
                    local d = (pos - RootPart.Position).Magnitude
                    if d < shortest then
                        closest = atm
                        shortest = d
                    end
                end
            end
        end
    end
    return closest
end

function Sf:DepositAllMoney()
    if tick() - Config.LastDepositTime < Config.DepositCooldown then
        return true
    end
    
    local handMoney = Sf:GetMoney()
    if handMoney <= 0 then
        return true
    end

    local atm = FindClosestAvailableATM()
    if not atm then
        return false
    end

    local atmPos = atm.Area and atm.Area.Position or atm.PrimaryPart and atm.PrimaryPart.Position
    if not atmPos then
        return false
    end
    
    Sf:Teleport(atmPos, Config.AutoFarmFishing)
    
    local timeout = tick() + 15
    local reached = false
    
    while tick() < timeout do
        if Config.Paused or not Config.AutoFarmFishing then
            return false
        end
        local dist = (RootPart.Position - atmPos).Magnitude
        if dist < 10 then
            reached = true
            break
        end
        task.wait(0.2)
    end
    
    if not reached then
        return false
    end
    
    task.wait(0.5)
    
    local currentHand = Sf:GetMoney()
    if currentHand <= 0 then
        Config.LastDepositTime = tick()
        return true
    end
    
    local success = pcall(function()
        Net.get("transfer_funds", "hand", "bank", currentHand)
    end)

    if success then
        Config.LastDepositTime = tick()
        task.wait(0.3)
        return true
    else
        return false
    end
end

function Sf:WithdrawSpecificAmount(amount)
    if amount <= 0 then
        return true
    end

    local currentHand = Sf:GetMoney()
    if currentHand >= amount then
        return true
    end

    local needed = amount - currentHand
    local bankMoney = Sf:GetBankMoney()

    if bankMoney < needed then
        return false
    end

    local atm = FindClosestAvailableATM()
    if not atm then
        return false
    end

    local atmPos = atm.Area and atm.Area.Position or atm.PrimaryPart and atm.PrimaryPart.Position
    if not atmPos then
        return false
    end
    
    local oldAutoDeposit = Config.AutoDepositJob
    Config.AutoDepositJob = false
    
    Sf:Teleport(atmPos, Config.AutoFarmFishing)
    
    local timeout = tick() + 15
    local reached = false
    
    while tick() < timeout do
        if Config.Paused or not Config.AutoFarmFishing then
            Config.AutoDepositJob = oldAutoDeposit
            return false
        end
        local dist = (RootPart.Position - atmPos).Magnitude
        if dist < 10 then
            reached = true
            break
        end
        task.wait(0.2)
    end
    
    if not reached then
        Config.AutoDepositJob = oldAutoDeposit
        return false
    end
    
    task.wait(0.5)
    
    local beforeWithdraw = Sf:GetMoney()
    if beforeWithdraw >= amount then
        Config.AutoDepositJob = oldAutoDeposit
        return true
    end
    
    local finalNeeded = amount - beforeWithdraw
    if finalNeeded <= 0 then
        Config.AutoDepositJob = oldAutoDeposit
        return true
    end
    
    local success = pcall(function()
        Net.get("transfer_funds", "bank", "hand", finalNeeded)
    end)

    Config.AutoDepositJob = oldAutoDeposit

    if success then
        task.wait(0.5)
        return true
    else
        return false
    end
end

local function WaitForMoneyUpdate(expectedMinMoney, timeout)
    timeout = timeout or 5
    local startTime = tick()
    local lastMoney = Sf:GetMoney()
    
    local attempts = 0
    while tick() - startTime < timeout and attempts < 20 do
        attempts = attempts + 1
        local currentMoney = Sf:GetMoney()
        
        if currentMoney ~= lastMoney or currentMoney >= expectedMinMoney then
            return true, currentMoney
        end
        
        task.wait(0.3)
    end
    
    local finalMoney = Sf:GetMoney()
    return false, finalMoney
end

local function CheckAndDeposit()
    if not Config.AutoDepositJob then 
        return true 
    end
    
    if tick() - Config.LastDepositTime < Config.DepositCooldown then
        return true
    end
    
    local handMoney = Sf:GetMoney()
    if handMoney < Config.DepositThreshold then 
        return true 
    end
    
    local oldWalking = c().StopWalking
    c().StopWalking = true
    task.wait(0.3)
    
    local success = Sf:DepositAllMoney()
    
    c().StopWalking = oldWalking
    
    return true
end

