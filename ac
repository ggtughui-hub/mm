        local hrp = getHRP()
        if hrp and not undergroundBaseCFrame then 
            undergroundBaseCFrame = hrp.CFrame + Vector3.new(0, DROP_DEPTH, 0)
            hrp.CFrame = undergroundBaseCFrame
        end
        if not flickering then
            flickering = true
            task.spawn(function()
                while flickering and enabled and isDowned() do
                    local hrp2 = getHRP()
                    if hrp2 and undergroundBaseCFrame then
                        local angle = math.random() * math.pi * 2
                        local offset = Vector3.new(math.cos(angle), 0, math.sin(angle)) * MOVE_RADIUS
                        hrp2.CFrame = CFrame.new(undergroundBaseCFrame.Position + offset)
