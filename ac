-- ==========================================
function Sf:AutoSellFish()
    local isFull, current, maxSlots = self:IsInventoryFull()
    
    if not isFull then
        return false
    end
    
    local sellBeacon = workspace:FindFirstChild("SellFishBeacon")
    local touchPart = sellBeacon and sellBeacon:FindFirstChild("TouchPart")
    
    if not touchPart then
        return false
    end
    
    self:Teleport(touchPart.Position, Config.AutoFarmFishing)
    
    local timeout = tick() + 15
    local reached = false
    
    while tick() < timeout do
        if Config.Paused or not Config.AutoFarmFishing then
            return false
        end
        local dist = (RootPart.Position - touchPart.Position).Magnitude
        if dist < 10 then
            reached = true
            break
        end
        task.wait(0.2)
    end
    
    if not reached then
        return false
    end
    
    task.wait(0.5)
    
    local hasFish = false
    local items = PlayerGui:FindFirstChild("Items")
    if items then
        local holder = items:FindFirstChild("ItemsHolder")
        if holder then
            local scroll = holder:FindFirstChild("ItemsScrollingFrame")
            if scroll then
                for _, v in pairs(scroll:GetChildren()) do
                    if v.Name ~= 'Folder' and v.Name ~= 'UIGridLayout' and v.Name ~= "ItemTemplate" then
                        local itemType = v:GetAttribute("ItemType")
                        if itemType and string.lower(tostring(itemType)) == "fish" then
                            hasFish = true
                            break
                        end
                    end
                end
            end
        end
    end
    
    if hasFish then
        Net.get("sell_all_fish")
        task.wait(0.5)
        
        local waitSuccess, updatedMoney = WaitForMoneyUpdate(Config.DepositThreshold, 5)
        
        if Config.AutoDepositJob and updatedMoney >= Config.DepositThreshold then
            local oldWalking = c().StopWalking
            c().StopWalking = true
            task.wait(0.3)
            
            Sf:DepositAllMoney()
            
            c().StopWalking = oldWalking
        end
        
        return true
    end
    
    return false
end

