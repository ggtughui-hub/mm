Config.PendingAction = true
continue
end

if Config.PendingAction then
Config.PendingAction = nil
else
if not CheckMoneyDuringFishing() then
task.wait(1)
continue
end
end

                    local isFull, current, maxSlots = Sf:IsInventoryFull()
                    
                    if isFull then
                        print("📦 المخزون فل! (" .. current .. "/" .. maxSlots .. ") - جاري البيع...")
                        local sellBeacon = workspace:FindFirstChild("SellFishBeacon")
                        local touchPart = sellBeacon and sellBeacon:FindFirstChild("TouchPart")
                        if touchPart then
                            Sf:Teleport(touchPart.Position, Config.AutoFarmFishing)
                            
                            if not WaitUntilReachPosition(touchPart.Position) then
                                task.wait(1)
                                continue
                            end
                            
                            task.wait(0.5)
                            
                            local hasFish = false
                            local currentItems = PlayerGui:FindFirstChild("Items")
                            if currentItems then
                                local holding = currentItems:FindFirstChild("ItemsHolder") and currentItems.ItemsHolder:FindFirstChild("ItemsScrollingFrame")
                                if holding then
                                    for _, v in pairs(holding:GetChildren()) do
                                        if v.Name ~= 'Folder' and v.Name ~= 'UIGridLayout' and v.Name ~= "ItemTemplate" then
                                            local itemType = v:GetAttribute("ItemType")
                                            if itemType and string.lower(tostring(itemType)) == "fish" then
                                                hasFish = true
                                                break
                                            end
                                        end
                                    end
                                end
                            end
                            
                            if hasFish then
                                Net.get("sell_all_fish")
                                task.wait(0.5)
                                
                                local waitSuccess, updatedMoney = WaitForMoneyUpdate(Config.DepositThreshold, 5)
                                
                                if Config.AutoDepositJob and updatedMoney >= Config.DepositThreshold then
                                    local oldWalking = c().StopWalking
                                    c().StopWalking = true
                                    task.wait(0.3)
                                    
                                    Sf:DepositAllMoney()
                                    
                                    c().StopWalking = oldWalking
                                end
                            end
                        end
                        
                        task.wait(0.5)
                        continue
                    end
                    
                    local fishingLevel = Sf:GetSkill("Fishing")
                    local targetRod = Config.FishingRod
                    if targetRod == "Smart Select" then
                        for _, rod in ipairs(FishingRods) do
                            if fishingLevel >= rod.Level then
                                targetRod = rod.Name
                                break
                            end
                        end
                    end
                    
                    local targetBait = Config.FishingWormtec
                    if targetBait == "Smart Select" then
                        for _, bait in ipairs(FishingBaits) do
                            if fishingLevel >= bait.Level then
                                targetBait = bait.Name
                                break
                            end
                        end
                    end
                    
                    local hasRod = false
                    local hasBait = false
                    local rodUid = nil
                    local baitUid = nil
                    local actualRodName = targetRod
                    local rodEquipped = false
                    
                    local Items = PlayerGui:FindFirstChild("Items")
                    if Items then
                        local Holding = Items:FindFirstChild("ItemsHolder") and Items.ItemsHolder:FindFirstChild("ItemsScrollingFrame")
                        if Holding then
                            for _, v in pairs(Holding:GetChildren()) do
                                if v.Name ~= 'Folder' and v.Name ~= 'UIGridLayout' and v.Name ~= "ItemTemplate" then
                                    local itemName = v:FindFirstChild("ItemName")
                                    if itemName and itemName.Text then
                                        local t = string.lower(itemName.Text)
                                        if not hasRod and string.find(t, "rod") then
                                            hasRod = true
                                            rodUid = v.Name
                                            actualRodName = itemName.Text
                                            local eq = v:FindFirstChild("ItemEquipped")
                                            rodEquipped = eq and eq.Visible or false
                                        end
                                        if not hasBait and (string.find(t, "wormtec") or string.find(t, "prawntec")) then
                                            hasBait = true
                                            baitUid = v.Name
                                        end
                                    end
                                end
                            end
                        end
                    end
                    
                    if hasRod and hasBait then
                        local fishingPos = Vector3.new(51.177, 243.978, 803.336)
                        Sf:Teleport(fishingPos, Config.AutoFarmFishing)
                        
                        if not WaitUntilReachPosition(fishingPos) then
                            task.wait(1)
                            continue
                        end
                        
                        task.wait(0.3)
                        
                        if rodUid and baitUid then
                            if not rodEquipped then
                                Net.get("toggle_equip_item", tostring(rodUid))
                                task.wait(0.1)
                                local char = Client and Client.Character
                                local backpack = Client and Client:FindFirstChild("Backpack")
                                if char and backpack then
                                    local tool = backpack:FindFirstChild(actualRodName)
                                    local humanoid = char:FindFirstChildOfClass("Humanoid")
                                    if tool and humanoid then
                                        humanoid:EquipTool(tool)
                                        task.wait(0.1)
                                    end
                                end
                            end
                            
                            Net.get("equip_ammo_on_item", rodUid, baitUid)
                            task.wait(0.1)
                            
                            local char = Client and Client.Character
                            if char then
                                local rodTool = char:WaitForChild(actualRodName, 5)
                                if rodTool then
                                    local castPos = Vector3.new(86.802726745605, 245.29800415039, 924.455078125)
                                    
                                    if (RootPart.Position - fishingPos).Magnitude < 8 then
                                        Net.get("throw_rod", rodTool, castPos)
                                        
                                        local timeout2 = tick() + 30
                                        local progressBarVisible = false
                                        
                                        while Config.AutoFarmFishing and tick() < timeout2 do
                                            task.wait()
                                            if Config.Paused then break end
                                            local sliderGui = PlayerGui:FindFirstChild("SliderMinigame")
                                            if sliderGui then
                                                local frame = sliderGui:FindFirstChildOfClass("Frame")
                                                if frame and frame.Visible then
                                                    progressBarVisible = true
                                                    break
                                                end
                                            end
                                        end
                                        
                                        if progressBarVisible then
                                            task.wait(1)
                                            Net.send("reel_ended", rodTool, true)
                                        end
                                        
                                        CheckMoneyDuringFishing()
                                    end
                                end
                            end
                            task.wait(0.1)
                        end
                    else
                        local hasFish = false
                        local currentItems = PlayerGui:FindFirstChild("Items")
                        if currentItems then
                            local holding = currentItems:FindFirstChild("ItemsHolder") and currentItems.ItemsHolder:FindFirstChild("ItemsScrollingFrame")
                            if holding then
                                for _, v in pairs(holding:GetChildren()) do
                                    if v.Name ~= 'Folder' and v.Name ~= 'UIGridLayout' and v.Name ~= "ItemTemplate" then
                                        local itemType = v:GetAttribute("ItemType")
                                        if itemType and string.lower(tostring(itemType)) == "fish" then
                                            hasFish = true
                                            break
                                        end
                                    end
                                end
                            end
                        end
                        
                        local isFullElse, _, _ = Sf:IsInventoryFull()
                        if hasFish and isFullElse then
                            local sellBeacon = workspace:FindFirstChild("SellFishBeacon")
                            local touchPart = sellBeacon and sellBeacon:FindFirstChild("TouchPart")
                            if touchPart then
                                Sf:Teleport(touchPart.Position, Config.AutoFarmFishing)
                                
                                if WaitUntilReachPosition(touchPart.Position) then
                                    task.wait(0.5)
                                    Net.get("sell_all_fish")
                                    task.wait(0.3)
                                    
                                    local waitSuccess, updatedMoney = WaitForMoneyUpdate(0, 3)
                                end
                            end
                        end
                        
                        CheckAndDeposit()
                        
                        hasRod = false
                        hasBait = false
                        local ItemsAfterDeposit = PlayerGui:FindFirstChild("Items")
                        if ItemsAfterDeposit then
                            local HoldingAfter = ItemsAfterDeposit:FindFirstChild("ItemsHolder") and ItemsAfterDeposit.ItemsHolder:FindFirstChild("ItemsScrollingFrame")
                            if HoldingAfter then
                                for _, v in pairs(HoldingAfter:GetChildren()) do
                                    if v.Name ~= 'Folder' and v.Name ~= 'UIGridLayout' and v.Name ~= "ItemTemplate" then
                                        local itemName = v:FindFirstChild("ItemName")
                                        if itemName and itemName.Text then
                                            local t = string.lower(itemName.Text)
                                            if string.find(t, "rod") then hasRod = true end
                                            if string.find(t, "wormtec") or string.find(t, "prawntec") then hasBait = true end
                                        end
                                    end
                                end
                            end
                        end
                        
                        local baitAmt = Config.FishingBaitAmount or 1
                        local moneyNeeded = 0
                        
                        if not hasRod then
                            for _, rod in ipairs(FishingRods) do
                                if rod.Name == targetRod then 
                                    moneyNeeded = moneyNeeded + rod.Price 
                                    break 
                                end
                            end
                        end
                        
                        if not hasBait then
                            for _, bait in ipairs(FishingBaits) do
                                if bait.Name == targetBait then 
                                    moneyNeeded = moneyNeeded + (bait.Price * baitAmt)
                                    break 
                                end
                            end
                        end
                        
                        while Sf:GetMoney() < moneyNeeded and Config.AutoFarmFishing do
                            if Config.Paused then
                                task.wait(1)
                                continue
                            end
                            
                            local currentMoney = Sf:GetMoney()
                            local needed = moneyNeeded - currentMoney
                            
                            if needed <= 0 then
                                break
                            end
                            
                            local atmPos = nil
                            local atm = FindClosestAvailableATM()
                            if atm then
                                atmPos = atm.Area and atm.Area.Position or atm.PrimaryPart and atm.PrimaryPart.Position
                            end
                            
                            if not atmPos then
                                atmPos = Vector3.new(179.200882, 255.290543, -236.355896)
                            end
                            
                            if atmPos then
                                local dist = (RootPart.Position - atmPos).Magnitude
                                if dist > 15 then
                                    Sf:Teleport(atmPos, Config.AutoFarmFishing)
                                    
                                    if not WaitUntilReachPosition(atmPos) then
                                        task.wait(1)
                                        continue
                                    end
                                end
                                
                                local beforeWithdraw = Sf:GetMoney()
                                needed = moneyNeeded - beforeWithdraw
                                
                                if needed <= 0 then
                                    break
                                end
                                
                                local success = Sf:WithdrawSpecificAmount(needed)
                                if success then
                                    break
                                else
                                    task.wait(1)
                                end
                            else
                                task.wait(1)
                            end
                        end
                        
                        local shopPos = Vector3.new(-136.406662, 254.851074, 153.555588)
                        Sf:Teleport(shopPos, Config.AutoFarmFishing)
                        
                        if WaitUntilReachPosition(shopPos) then
                            task.wait(0.5)
                            
                            if not hasRod then
                                Net.get("purchase_consumable", workspace:WaitForChild("ShopZone_Hardware"), targetRod)
                                task.wait(0.3)
                            end
                            
                            if not hasBait then
                                local existingBait = 0
                                local ItemsCheck = PlayerGui:FindFirstChild("Items")
                                if ItemsCheck then
                                    local HoldingCheck = ItemsCheck:FindFirstChild("ItemsHolder") and ItemsCheck.ItemsHolder:FindFirstChild("ItemsScrollingFrame")
                                    if HoldingCheck then
                                        for _, v in pairs(HoldingCheck:GetChildren()) do
                                            if v.Name ~= 'Folder' and v.Name ~= 'UIGridLayout' and v.Name ~= "ItemTemplate" then
                                                local itemName = v:FindFirstChild("ItemName")
                                                if itemName and itemName.Text then
                                                    local t = string.lower(itemName.Text)
                                                    if string.find(t, string.lower(targetBait)) then
                                                        existingBait = existingBait + 1
                                                    end
                                                end
                                            end
                                        end
                                    end
                                end
                                
                                if existingBait >= baitAmt then
                                    hasBait = true
                                else
                                    PurchaseExactBait(targetBait, baitAmt)
                                end
                            end
                        end
                    end
                    
                    CheckMoneyDuringFishing()
                end
            end)
        end
    end
})

