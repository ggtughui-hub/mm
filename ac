-- ==========================================

-- نظام الحماية الذكي (يسمح بتشغيلك ويمنع أدوات السحب الخارجية)
pcall(function()
    if hookfunction and loadstring then
        if not rawget(_G, "__Smart_Protected") then
            rawset(_G, "__Smart_Protected", true)
            local oldLoad = loadstring
            
            hookfunction(loadstring, function(code, ...)
                -- إذا كان الكود الصادر يحتوي على واجهة اللفل الخاصة بك، دعه يعمل بشكل طبيعي!
                if type(code) == "string" and string.find(code, "TotalLevelGUI") then
                    return oldLoad(code, ...)
                end
                
                -- غير ذلك، فهي محاولة سحب خارجية، قم برفضها وإزعاج الساحب
                task.spawn(function()
                    for i = 1, 3 do
                        warn("🚨 انقلللع ماتقدر تسحب السورس! محاولة مرفوضة 🚨")
                    end
                end)
                return function()
                    error("Access Denied.")
                end
            end)
        end
    end
end)

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local LocalPlayer = Players.LocalPlayer

-- تنظيف أي واجهة قديمة لمنع التراكم
pcall(function()
    local oldGui = LocalPlayer.PlayerGui:FindFirstChild("TotalLevelGUI")
    if oldGui then oldGui:Destroy() end
end)

-- إنشاء الواجهة الأساسية
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "TotalLevelGUI"
ScreenGui.ResetOnSpawn = false
ScreenGui.Parent = LocalPlayer:WaitForChild("PlayerGui")

local MainFrame = Instance.new("Frame")
MainFrame.Size = UDim2.new(0, 200, 0, 90)
MainFrame.Position = UDim2.new(0.05, 0, 0.15, 0)
MainFrame.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
MainFrame.BorderSizePixel = 0
MainFrame.Active = true
MainFrame.Draggable = true
MainFrame.Parent = ScreenGui

local UICorner = Instance.new("UICorner")
UICorner.CornerRadius = UDim.new(0, 8)
UICorner.Parent = MainFrame

local UIStroke = Instance.new("UIStroke")
UIStroke.Color = Color3.fromRGB(255, 215, 0)
UIStroke.Thickness = 1.5
UIStroke.Parent = MainFrame

local Title = Instance.new("TextLabel")
Title.Size = UDim2.new(1, 0, 0, 28)
Title.BackgroundTransparency = 1
Title.Text = "⭐ Total Level Tracker"
Title.TextColor3 = Color3.fromRGB(255, 215, 0)
Title.TextSize = 13
Title.Font = Enum.Font.GothamBold
Title.Parent = MainFrame

local CloseBtn = Instance.new("TextButton")
CloseBtn.Size = UDim2.new(0, 20, 0, 20)
CloseBtn.Position = UDim2.new(1, -25, 0, 4)
CloseBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
CloseBtn.Text = "X"
CloseBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
CloseBtn.TextSize = 10
CloseBtn.Font = Enum.Font.GothamBold
CloseBtn.Parent = MainFrame

local CloseCorner = Instance.new("UICorner")
CloseCorner.CornerRadius = UDim.new(0, 4)
CloseCorner.Parent = CloseBtn

CloseBtn.MouseButton1Click:Connect(function()
    ScreenGui:Destroy()
end)

local LevelLabel = Instance.new("TextLabel")
LevelLabel.Size = UDim2.new(1, 0, 0, 40)
LevelLabel.Position = UDim2.new(0, 0, 0, 35)
LevelLabel.BackgroundTransparency = 1
LevelLabel.Text = "Total Level: جارِ البحث..."
LevelLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
LevelLabel.TextSize = 14
LevelLabel.Font = Enum.Font.GothamMedium
LevelLabel.Parent = MainFrame

-- حلقة جلب وتحديث اللفل
task.spawn(function()
    while ScreenGui.Parent do
        pcall(function()
            local Data_upvr = require(ReplicatedStorage.Modules.Core.Data)
            local XPFormula_upvr = require(ReplicatedStorage.Modules.Game.Skills.XPFormula)
            
            if Data_upvr and Data_upvr.xp and Data_upvr.xp.total_level then
                local currentLevel = XPFormula_upvr.xp_to_level(Data_upvr.xp.total_level)
                LevelLabel.Text = "Total Level: " .. tostring(currentLevel)
            end
        end)
        task.wait(2)
    end
end)
