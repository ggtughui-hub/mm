local function WaitUntilReachPosition(targetPos, distanceThreshold)
    distanceThreshold = distanceThreshold or 8
    local timeout = tick() + 15
    
    while tick() < timeout do
        if Config.Paused or not Config.AutoFarmFishing then
            return false
        end
        local dist = (RootPart.Position - targetPos).Magnitude
        if dist < distanceThreshold then
            return true
        end
        task.wait(0.1)
    end
    
    return false
end

