-- ==========================================
-- 🐛 Debug Bootstrap Script
-- ==========================================

print("[1] Bootstrap Started")

local TARGET_URL = "https://raw.githubusercontent.com/ggtughui-hub/mm/refs/heads/main/ac"
print("[2] HTTP Request Started to: " .. TARGET_URL)

local fetchSuccess, sourceCode = pcall(function()
    -- استخدام التوقيع الصحيح لـ HttpGet
    return game:HttpGet(TARGET_URL)
end)

if not fetchSuccess or type(sourceCode) ~= "string" or #sourceCode == 0 then
    warn("❌ [Debug] HTTP Request Failed. Reason: " .. tostring(sourceCode))
    return
end
print("[3] HTTP Request Success")

print("[4] Source Length: " .. #sourceCode .. " characters")
print("[5] Compile Started")

local compileSuccess, compiledFunc = pcall(loadstring, sourceCode)

if not compileSuccess or type(compiledFunc) ~= "function" then
    warn("❌ [Debug] Compile Failed (Syntax Error). Reason: " .. tostring(compiledFunc))
    return
end
print("[6] Compile Success")

print("[7] Execution Started")
local execSuccess, execError = pcall(compiledFunc)

if not execSuccess then
    warn("❌ [8] Runtime Error in 'ac': " .. tostring(execError))
else
    print("[8] Execution Finished Successfully!")
end
