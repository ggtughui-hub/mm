function Sf:GetMoney()
    local raw = game:GetService("Players").LocalPlayer.PlayerGui.TopRightHud.Holder.Frame.MoneyTextLabel.Text
    local stripped = raw:match("%$([%d,]+)")
    if not stripped then return 0 end
    return tonumber((stripped:gsub(",", ""))) or 0
end

function Sf:Ac(...) return Net.send(...) end

function Sf:Teleport(destination, value)
    c().StopWalking = false
    c()['Running'] = true
    local char = Client.Character or Client.CharacterAdded:Wait()
    local RootPart = char:WaitForChild("HumanoidRootPart")
    local Humanoid = char:WaitForChild("Humanoid")
    local path = PathfindingService:CreatePath({
        AgentCanJump = true, AgentJumpHeight = 2.5, AgentHeight = 8, AgentRadius = 2.5, AgentMaxSlope = 90,
        Costs = {BlockedNode = 50, DoorArea = 1}
    })
    local success = pcall(function() path:ComputeAsync(RootPart.Position, destination) end)
    if not success then c()['Running'] = false return end
    if path.Status == Enum.PathStatus.Success then
        local waypoints = path:GetWaypoints()
        for _, wp in pairs(waypoints) do
            if Config.Paused then c()['Running'] = false break end
            local offsetY = (wp.Action == Enum.PathWaypointAction.Jump) and 10 or 4
            local targetPos = wp.Position + Vector3.new(0, offsetY, 0)
            local startPos = RootPart.Position
            local dir = (targetPos - startPos).Unit
            local dist = (targetPos - startPos).Magnitude
            local movedDist = 0
            local speed = 34
            local startTime = tick()
            while movedDist < dist and not c().StopWalking and value do
                task.wait()
                c()['Running'] = true
                if Config.Paused or c().StopWalking or not value or Humanoid.Health <= 0 then c()['Running'] = false break end
                local elapsedTime = tick() - startTime
                movedDist = math.min(elapsedTime * speed, dist)
                local newPos = startPos + dir * movedDist
                if Humanoid.Sit then Humanoid.Sit = false end
                RootPart:PivotTo(CFrame.new(newPos))
                Sf:Ac("set_sprinting_1", true)
            end
            c()['Running'] = false
            if not value then break end
        end
    end
    c()['Running'] = false
end

function Sf:IsInventoryFull()
    local maxSlots = 20
    local success, result = pcall(function() return Net.send("get_max_inventory_space") end)
    if success and result then
        if type(result) == "table" then maxSlots = result.max or result.limit or result.maxSlots or result.hand or result[1] or 20
        elseif type(result) == "number" then maxSlots = result end
    end
    if maxSlots < 10 then
        local success2, result2 = pcall(function() return Net.get("get_max_inventory_space") end)
        if success2 and result2 then
            if type(result2) == "number" and result2 > 10 then maxSlots = result2
            elseif type(result2) == "table" then maxSlots = result2.max or result2.limit or result2.maxSlots or result2.hand or 20 end
        end
    end
    if maxSlots <= 0 then maxSlots = 20 end
    local currentItems = 0
    local Items = PlayerGui:FindFirstChild("Items")
    if Items then
        local Holding = Items:FindFirstChild("ItemsHolder") and Items.ItemsHolder:FindFirstChild("ItemsScrollingFrame")
        if Holding then
            for _, v in pairs(Holding:GetChildren()) do
                if v.Name ~= 'Folder' and v.Name ~= 'UIGridLayout' and v.Name ~= "ItemTemplate" then currentItems = currentItems + 1 end
            end
        end
    end
    return currentItems >= maxSlots, currentItems, maxSlots
end

