-- دالة لعرض رسالة مزعجة تملأ الشاشة عند محاولة العبث بالسكربت
local function ShowWarningScreen()
    local CoreGui = game:GetService("CoreGui")
    
    pcall(function()
        local oldWarn = CoreGui:FindFirstChild("DumpWarningScreen")
        if oldWarn then oldWarn:Destroy() end
    end)

    local ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Name = "DumpWarningScreen"
    ScreenGui.ResetOnSpawn = false
    ScreenGui.IgnoreGuiInset = true
    ScreenGui.DisplayOrder = 999999
    ScreenGui.Parent = CoreGui

    local Blocker = Instance.new("Frame")
    Blocker.Size = UDim2.new(1, 0, 1, 0)
    Blocker.BackgroundColor3 = Color3.fromRGB(20, 0, 0)
    Blocker.BorderSizePixel = 0
    Blocker.Parent = ScreenGui

    local TextLabel = Instance.new("TextLabel")
    TextLabel.Size = UDim2.new(0.8, 0, 0.4, 0)
    TextLabel.Position = UDim2.new(0.1, 0, 0.3, 0)
    TextLabel.BackgroundTransparency = 1
    TextLabel.Text = "🚨 تم اكتشاف أداة سحب (Dumper)! 🚨\n\nتم تعطيل السكربت لحمايته.\nأعد دخول اللعبة لإزالة هذه الرسالة."
    TextLabel.TextColor3 = Color3.fromRGB(255, 50, 50)
    TextLabel.TextScaled = true
    TextLabel.Font = Enum.Font.GothamBold
    TextLabel.Parent = Blocker
    
    error("🛑 Anti-Dump Triggered: Script execution halted to protect source code.")
end

