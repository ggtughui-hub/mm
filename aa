function Sf:RespawnAndMountVehicle()
    local existing = Sf:GetOwnedVehicle()
    if existing and existing.PrimaryPart then
        if Humanoid and Humanoid.Sit then
            return existing
        end
        Sf:EnterVehicle(existing)
        local sitTriesFast = 0
        while Humanoid and not Humanoid.Sit and sitTriesFast < 8 and Config.AutoFarmActive do
            Sf:EnterVehicle(existing)
            task.wait(0.12)
            sitTriesFast = sitTriesFast + 1
        end
        if Humanoid and Humanoid.Sit then
            return existing
        end
    end

    if Humanoid and Humanoid.Sit then
        Sf:ExitVehicle()
        task.wait(0.2)
    end
    
    local vehicleName, vehicleUid, equipped = Sf:GetVehicleUidFromInventory()
    if not vehicleName then
        local spawned = Sf:EnsureVehicle()
        if spawned then
            Sf:EnterVehicle(spawned)
            task.wait(0.15)
            return spawned
        end
        return nil
    end
    
    -- دائماً نسحبها أولاً حتى لو مرسبنة
    local pullTries = 0
    while (Sf:GetOwnedVehicle() or equipped) and pullTries < 8 and Config.AutoFarmActive do
        pcall(function() Net.get("toggle_equip_item", tostring(vehicleUid)) end)
        task.wait(0.25)
        _, vehicleUid, equipped = Sf:GetVehicleUidFromInventory()
        if not Sf:GetOwnedVehicle() and not equipped then
            break
        end
        pullTries = pullTries + 1
    end
    task.wait(0.15)
    
    -- بعد السحب نرسبنها من جديد
    pcall(function() Net.get("toggle_equip_item", tostring(vehicleUid)) end)
    
    local vehicle = nil
    local tries = 0
    while tries < 20 and Config.AutoFarmActive do
        vehicle = Sf:GetOwnedVehicle()
        if vehicle and vehicle.PrimaryPart then break end
        task.wait(0.15)
        tries = tries + 1
    end
    
    if not vehicle then
        return nil
    end
    
    task.wait(0.1)
    Sf:EnterVehicle(vehicle)
    
    local sitTries = 0
    while Humanoid and not Humanoid.Sit and sitTries < 15 and Config.AutoFarmActive do
        Sf:EnterVehicle(vehicle)
        task.wait(0.12)
        sitTries = sitTries + 1
    end
    
    if Humanoid and Humanoid.Sit then
    else
    end
    
    return vehicle
end

function Sf:EnsureVehicle()
    local vehicle = Sf:GetOwnedVehicle()
    if vehicle then return vehicle end
    
    local vehicleName = Sf:GetVehicleNameFromInventory()
    if not vehicleName then
        if Config.VehicleType == "Bike" then
            Sf:BuyBikeCrate()
            task.wait(1)
            vehicleName = Sf:GetVehicleNameFromInventory()
        end
        if not vehicleName then return nil end
    end
    
    local Items = PlayerGui:FindFirstChild("Items")
    local Holding = Items and Items:FindFirstChild("ItemsHolder") and Items.ItemsHolder:FindFirstChild("ItemsScrollingFrame")
    if Holding then
        for _, v in pairs(Holding:GetChildren()) do
            if v:FindFirstChild("ItemName") and v.ItemName.Text == vehicleName then
                local equipped = v:FindFirstChild("ItemEquipped")
                if not (equipped and equipped.Visible) then
                    pcall(function() Net.get("toggle_equip_item", tostring(v.Name)) end)
                    task.wait(0.4)
                end
                break
            end
        end
    end
    
    task.wait(0.5)
    return Sf:GetOwnedVehicle()
end

function Sf:ExitVehicle()
    if Humanoid and Humanoid.Sit then
        pcall(function() Net.get("exit_seat") end)
        task.wait(0.15)
        if RootPart then
            RootPart.CFrame = RootPart.CFrame * CFrame.new(-4, 0, 0)
        end
        task.wait(0.1)
    end
end

function Sf:EnterVehicle(vehicle)
    if not vehicle or not vehicle.PrimaryPart then return false end
    if Humanoid.Sit then return true end
    
    pcall(function() Net.send("lock_vehicle", vehicle, true) end)
    
    -- تحت الأرض ما ننقّل المركبة لفوق، بس نركب اللي تحتنا
    local currentTime = tick()
    local alreadyUnder = vehicle.PrimaryPart.Position.Y < 240
    if (not alreadyUnder) and currentTime - LastVehicleTeleport >= 0.6 then
        local charLook = RootPart.CFrame.LookVector
        local vehicleRotation = CFrame.new(RootPart.Position + Vector3.new(0, 6, 0)) * CFrame.Angles(0, math.atan2(charLook.X, charLook.Z), 0)
        vehicle:PivotTo(vehicleRotation)
        LastVehicleTeleport = currentTime
        task.wait(0.05)
    end
    
    for _, prompt in pairs(vehicle.PrimaryPart:GetDescendants()) do
        if prompt:IsA("ProximityPrompt") then
            fireproximityprompt(prompt)
            task.wait(0.05)
        end
    end
    
    local waitCount = 0
    while not Humanoid.Sit and waitCount < 12 and Config.AutoFarmActive do
        task.wait(0.1)
        waitCount = waitCount + 1
    end
    
    return Humanoid.Sit
end

function Sf:RepairVehicleIfNeeded(vehicleName)
    if not Config.AutoRepairVehicle then return end
    local currentHP, maxHP, vehicleUID = Sf:GetVehicleHealth(vehicleName)
    if currentHP and maxHP and (maxHP - currentHP) >= 800 then
        if Sf:GetMoney() < 1000 then
            if Sf:GetBankMoney() >= 1000 then
                pcall(function() Net.get("transfer_funds", "bank", "hand", 1000) end)
                task.wait(0.3)
            end
        end
        pcall(function() Net.get("repair_vehicle", vehicleUID) end)
        task.wait(0.4)
    end
end

