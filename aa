-- 🚀 Production Bootstrap Script
-- ==========================================

local TARGET_URL = "https://raw.githubusercontent.com/ggtughui-hub/mm/refs/heads/main/ac"

-- 1. تحميل السورس بشكل آمن
local fetchSuccess, sourceCode = pcall(function()
    return game:HttpGet(TARGET_URL)
end)

if not fetchSuccess or type(sourceCode) ~= "string" or #sourceCode == 0 then
    return -- تجاهل صامت في حال فشل الإنترنت
end

-- 2. تجميع الكود (Compile)
local compileSuccess, compiledFunc = pcall(loadstring, sourceCode)

-- 3. تقليل السورس المكشوف: مسح النص من الذاكرة فور تجميعه
sourceCode = nil 
if collectgarbage then collectgarbage("collect") end

if not compileSuccess or type(compiledFunc) ~= "function" then
    return -- تجاهل صامت في حال وجود خطأ برمجي في السكربت
end

-- 4. تنفيذ السكربت الأساسي (ac) في بيئة طبيعية 100%
local execSuccess, execError = pcall(compiledFunc)

if not execSuccess then
    -- إظهار الخطأ فقط إذا كان من داخل السكربت الأساسي لكي تتمكن من إصلاحه
    warn("❌ [Bootstrap] Runtime Error in 'ac': " .. tostring(execError))
end
