local function DoIdleTouch()
    -- لمسة خمول للجوال والكمبيوتر بدون تحريك المركبة
    pcall(function()
        local vim = game:GetService("VirtualInputManager")
        local cam = workspace.CurrentCamera
        local pos = cam and cam.ViewportSize or Vector2.new(400, 400)
        local x, y = pos.X * 0.5, pos.Y * 0.5
        vim:SendMouseButtonEvent(x, y, 0, true, game, 1)
        task.wait(0.04)
        vim:SendMouseButtonEvent(x, y, 0, false, game, 1)
        vim:SendMouseButtonEvent(x + 2, y + 2, 0, true, game, 1)
        task.wait(0.04)
        vim:SendMouseButtonEvent(x + 2, y + 2, 0, false, game, 1)
    end)
    pcall(function()
        local vu = game:GetService("VirtualUser")
        vu:CaptureController()
        vu:ClickButton1(Vector2.new(200, 200))
    end)
    pcall(function()
        local cam = workspace.CurrentCamera
        if cam then
            cam.CFrame = cam.CFrame * CFrame.Angles(0, math.rad(0.4), 0)
        end
    end)
end

local function EnableAntiKick(v)
    AntiKickEnabled = v and true or false
    if AntiKickEnabled and not antiIdleRunning then
        antiIdleRunning = true
        task.spawn(function()
            while AntiKickEnabled do
                task.wait(900)
                if AntiKickEnabled then
                    DoIdleTouch()
                end
            end
            antiIdleRunning = false
        end)
    end
end

