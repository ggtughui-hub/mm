        and workspace.Map.Tiles.BurgerPlaceTile:FindFirstChild("UrbanCyclesAndSkates") 
        and workspace.Map.Tiles.BurgerPlaceTile.UrbanCyclesAndSkates:FindFirstChild("Interior")
        and workspace.Map.Tiles.BurgerPlaceTile.UrbanCyclesAndSkates.Interior:FindFirstChild("Crates")
        and workspace.Map.Tiles.BurgerPlaceTile.UrbanCyclesAndSkates.Interior.Crates:FindFirstChild("Bike Crate")
    
    if not bikeCrate then return false end
    local touchPart = bikeCrate:FindFirstChild("Beacon") and bikeCrate.Beacon:FindFirstChild("TouchPart")
    if not touchPart then return false end

    if Sf:GetMoney() < BIKE_CRATE_COST then
        if Sf:GetBankMoney() >= BIKE_CRATE_COST then
            Sf:SmartMoveTo(BIKE_ATM_CFRAME.Position)
            task.wait(0.3)
            local needed = BIKE_CRATE_COST - Sf:GetMoney()
            if needed > 0 then
                pcall(function() Net.get("transfer_funds", "bank", "hand", needed) end)
                task.wait(0.4)
