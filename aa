function Sf:GetOwnedVehicle()
    for _, vehicle in ipairs(workspace.Vehicles:GetChildren()) do
        if vehicle:GetAttribute('OwnerUserId') == UserId and vehicle.PrimaryPart then
            return vehicle
        end
    end
    return nil
end

function Sf:GetVehicleNameFromInventory()
    local ScrollingFrame = PlayerGui:FindFirstChild("Items") and PlayerGui.Items:FindFirstChild("ItemsHolder") and PlayerGui.Items.ItemsHolder:FindFirstChild("ItemsScrollingFrame")
    if not ScrollingFrame then return nil end
    
    if Config.VehicleType == "Bike" then
        for _, v in ipairs(ScrollingFrame:GetChildren()) do
            if v:GetAttribute("ItemType") == "bike" then
                return v.ItemName.Text
            end
        end
    else
        for _, v in ipairs(ScrollingFrame:GetChildren()) do
            if v:GetAttribute('ItemType') == "car" then
                return v.ItemName.Text
            end
        end
    end
    return nil
end

function Sf:GetVehicleHealth(vehicleName)
    local ScrollingFrame = PlayerGui:FindFirstChild("Items") and PlayerGui.Items:FindFirstChild("ItemsHolder") and PlayerGui.Items.ItemsHolder:FindFirstChild("ItemsScrollingFrame")
    if not ScrollingFrame then return nil, nil, nil end
    for _, v in ipairs(ScrollingFrame:GetChildren()) do
        if (v:GetAttribute('ItemType') == "car" or v:GetAttribute('ItemType') == "bike") and v.ItemName.Text == vehicleName then
            local healthLabel = v:FindFirstChild("ItemHealth")
            if healthLabel and healthLabel.Text then
                local current, max = healthLabel.Text:match("(%d+)/(%d+)")
                return tonumber(current), tonumber(max), v.Name
            end
        end
    end
    return nil, nil, nil
end

function Sf:BuyBikeCrate()
