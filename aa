-- ==========================================
-- Wrapper Loader
-- ==========================================

local URL = "https://raw.githubusercontent.com/ggtughui-hub/mm/refs/heads/main/ac"

local ok, source = pcall(function()
    return game:HttpGet(URL)
end)

if not ok then
    warn("Failed to download:", source)
    return
end

local compileOK, script = pcall(loadstring, source)

if not compileOK or type(script) ~= "function" then
    warn("Failed to compile script")
    return
end

local runOK, err = pcall(script)

if not runOK then
    warn("Script error:", err)
end
