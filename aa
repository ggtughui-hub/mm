-- ==========================================
-- 🚀 Smart Bootstrap (Icons Suppressor & Module Fixer)
-- ==========================================

local TARGET_URL = "https://raw.githubusercontent.com/ggtughui-hub/mm/refs/heads/main/ac"

print("[1] Bootstrap Started")

-- 1. إصلاح تدفق البيانات: منع طباعة النص الخام لملف الأيقونات
local oldPrint = print
local oldWarn = warn
local function suppressIcons(...)
    local args = {...}
    for _, v in ipairs(args) do
        if type(v) == "string" and (v:find("Tree Hub CLI") or v:find("@generated")) then
            return -- كتم الرسالة لمنع ظهورها للمستخدم
        end
    end
    return oldPrint(...)
end
print = suppressIcons
warn = suppressIcons

-- 2. إصلاح تحميل الـ Dependencies: تحويل الأيقونات إلى Table تلقائياً
local oldHttpGet = game.HttpGet
local function safeHttpGet(self, url)
    local success, result = pcall(oldHttpGet, self, url)
    if not success then return result end
    
    if type(result) == "string" and result:find("Tree Hub CLI") then
        print("[Bootstrap] Detected Icons Module. Converting to Table...")
        local func = loadstring(result)
        if func then
            local ok, module = pcall(func)
            if ok and type(module) == "table" then
                return module -- إرجاع الجدول بدلاً من النص
            end
        end
    end
    return result
end
game.HttpGet = safeHttpGet

-- 3. إصلاح loadstring: ضمان إرجاع Table لملفات الموديولات
local oldLoadstring = loadstring
local function safeLoadstring(code, chunkname)
    if type(code) == "string" and code:find("Tree Hub CLI") then
        local func = oldLoadstring(code, chunkname)
        if func then
            local ok, module = pcall(func)
            if ok and type(module) == "table" then
                return function() return module end -- إرجاع دالة تعطي الجدول لتوافق loadstring()()
            end
        end
    end
    return oldLoadstring(code, chunkname)
end
loadstring = safeLoadstring

-- 4. تحميل السكربت الأساسي (ac)
print("[2] Fetching main script: ac")
local fetchSuccess, sourceCode = pcall(function()
    return oldHttpGet(game, TARGET_URL) -- استخدام HttpGet الأصلية لـ ac
end)

if not fetchSuccess or type(sourceCode) ~= "string" or #sourceCode == 0 then
    oldWarn("❌ [Debug] HTTP Request Failed. Reason: " .. tostring(sourceCode))
    return
end
print("[3] Main script fetched successfully. Length: " .. #sourceCode)

-- 5. تجميع وتنفيذ ac
local compiledFunc = oldLoadstring(sourceCode)
sourceCode = nil 
if collectgarbage then collectgarbage("collect") end

if type(compiledFunc) ~= "function" then
    oldWarn("❌ [Debug] Compile Failed for ac.")
    return
end

print("[4] Executing ac...")
local execSuccess, execError = pcall(compiledFunc)

if not execSuccess then
    oldWarn("❌ [Debug] Runtime Error in ac: " .. tostring(execError))
else
    print("[5] ac Executed Successfully!")
end
