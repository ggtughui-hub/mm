    end
end

local function PotsDrive(vehicle, destination)
    if not vehicle or not vehicle.PrimaryPart then return end
    local targetY = destination.Y
    local goal = Vector3.new(destination.X, targetY, destination.Z)
    local speed = Config.VehicleSpeed or 55
    PotsUpdatePlatform(vehicle)
    if Humanoid and not Humanoid.Sit then
        pcall(function() Sf:EnterVehicle(vehicle) end)
        task.wait(0.1)
    end
    local t0, last = tick(), tick()
    Config.Running = true
    Config.StopWalking = false
    while Config.AutoFarmActive and not isProtectionTriggered and not Config.StopWalking do
        task.wait()
        if not vehicle.PrimaryPart then break end
        if tick() - t0 > 35 then break end
        if Humanoid and not Humanoid.Sit then
            pcall(function() Sf:EnterVehicle(vehicle) end)
        end
        local now = Vector3.new(vehicle.PrimaryPart.Position.X, targetY, vehicle.PrimaryPart.Position.Z)
        local toGoal = Vector3.new(goal.X - now.X, 0, goal.Z - now.Z)
        if toGoal.Magnitude <= 4 then break end
        local dir = toGoal.Unit
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances = {Character, vehicle, PotsHiddenPlatform}
        if workspace:Raycast(now, dir * 16, params) then
            local right = Vector3.new(-dir.Z, 0, dir.X)
            dir = (dir * 0.25 + right * ((tick() % 2 < 1) and 1 or -1)).Unit
        end
        local dt = math.clamp(tick() - last, 0, 0.05)
        last = tick()
        local step = math.min(speed * dt, toGoal.Magnitude)
        local newPos = Vector3.new(now.X + dir.X * step, targetY, now.Z + dir.Z * step)
        vehicle:PivotTo(CFrame.new(newPos) * CFrame.Angles(0, math.atan2(dir.X, dir.Z), 0))
        PotsUpdatePlatform(vehicle)
        for _, part in ipairs(vehicle:GetDescendants()) do
            if part:IsA("BasePart") then
                part.AssemblyLinearVelocity = Vector3.zero
                part.AssemblyAngularVelocity = Vector3.zero
            end
        end
    end
    Config.Running = false
    UpdateActivity()
end

local function PotsSmoothY(targetY, duration)
    duration = duration or 1.0
    local vehicle = Sf:GetOwnedVehicle()
    local useV = vehicle and vehicle.PrimaryPart
    if useV and Humanoid and not Humanoid.Sit then
        pcall(function() Sf:EnterVehicle(vehicle) end)
        task.wait(0.12)
    end
    local start = useV and vehicle:GetPivot() or (RootPart and RootPart.CFrame)
    if not start then return end
    local startY = start.Position.Y
    local xz = Vector3.new(start.Position.X, 0, start.Position.Z)
    local rot = start - start.Position
    local t0 = tick()
    while tick() - t0 < duration and Config.AutoFarmActive and not isProtectionTriggered do
        local a = math.clamp((tick() - t0) / duration, 0, 1)
        a = a * a * (3 - 2 * a)
        local cf = CFrame.new(xz.X, startY + (targetY - startY) * a, xz.Z) * rot
        if useV and vehicle and vehicle.PrimaryPart then
            vehicle:PivotTo(cf)
            PotsUpdatePlatform(vehicle)
            for _, part in ipairs(vehicle:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.AssemblyLinearVelocity = Vector3.zero
                    part.AssemblyAngularVelocity = Vector3.zero
                end
            end
        elseif RootPart then
            RootPart.CFrame = cf
        end
        task.wait(0.016)
    end
    UpdateActivity()
end

local function PotsGo(destination)
    if not Config.AutoFarmActive or isProtectionTriggered then return end
    local dest = Vector3.new(destination.X, POTS_UNDER_Y, destination.Z)
