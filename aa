local HiddenPlatform = nil

function Sf:CreateHiddenPlatform(vehicle)
    if HiddenPlatform and HiddenPlatform.Parent then
        HiddenPlatform:Destroy()
    end
    
    local platform = Instance.new("Part")
    platform.Name = "HiddenFlightPlatform"
    platform.Size = Vector3.new(18, 2, 18)
    platform.Transparency = 1
    platform.CanCollide = true
    platform.Anchored = true
    platform.Material = Enum.Material.SmoothPlastic
    platform.Parent = workspace
    
    if vehicle and vehicle.PrimaryPart then
        local pos = vehicle.PrimaryPart.Position
        platform.CFrame = CFrame.new(pos.X, pos.Y - 1.5, pos.Z)
    else
        platform.CFrame = CFrame.new(0, UNDERGROUND_Y - 1.5, 0)
    end
    
    HiddenPlatform = platform
    return platform
end

function Sf:UpdateHiddenPlatform(vehicle)
    if not HiddenPlatform or not HiddenPlatform.Parent then return end
    if not vehicle or not vehicle.PrimaryPart then return end
    local pos = vehicle.PrimaryPart.Position
    HiddenPlatform.CFrame = CFrame.new(pos.X, pos.Y - 1.5, pos.Z)
end

function Sf:DestroyHiddenPlatform()
    if HiddenPlatform and HiddenPlatform.Parent then
        HiddenPlatform:Destroy()
    end
    HiddenPlatform = nil
end

function Sf:SmoothVerticalMove(targetY, duration, forceMove)
    duration = duration or 1.5
    if not RootPart or not Humanoid then return end
    
    local vehicle = Sf:GetOwnedVehicle()
    local useVehicle = Config.UseVehicle and vehicle and vehicle.PrimaryPart
    
    if useVehicle then
        if not Humanoid.Sit then
            Sf:EnterVehicle(vehicle)
            task.wait(0.3)
        end
        vehicle = Sf:GetOwnedVehicle()
        if not (vehicle and vehicle.PrimaryPart) then
            useVehicle = false
        end
    end
    
    local startCFrame
    if useVehicle then
        startCFrame = vehicle:GetPivot()
    else
        startCFrame = RootPart.CFrame
    end
    
    local startY = startCFrame.Position.Y
    local startXZ = Vector3.new(startCFrame.Position.X, 0, startCFrame.Position.Z)
    local rotOnly = startCFrame - startCFrame.Position
    local startTime = tick()
    
    if useVehicle then
        Sf:CreateHiddenPlatform(vehicle)
    end
    
    local function ForceHold(cframe)
        if useVehicle and vehicle and vehicle.PrimaryPart then
            vehicle:PivotTo(cframe)
            for _, part in ipairs(vehicle:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.AssemblyLinearVelocity = Vector3.zero
                    part.AssemblyAngularVelocity = Vector3.zero
                end
            end
            Sf:UpdateHiddenPlatform(vehicle)
            if Humanoid then Humanoid.Sit = true end
            if RootPart then
                RootPart.AssemblyLinearVelocity = Vector3.zero
                RootPart.AssemblyAngularVelocity = Vector3.zero
            end
        elseif RootPart then
            RootPart.CFrame = cframe
            RootPart.AssemblyLinearVelocity = Vector3.zero
            RootPart.AssemblyAngularVelocity = Vector3.zero
        end
    end
    
    while (tick() - startTime) < duration and (forceMove or (Config.AutoFarmActive and not isProtectionTriggered)) do
        local alpha = math.clamp((tick() - startTime) / duration, 0, 1)
        alpha = alpha * alpha * (3 - 2 * alpha)
        local newY = startY + (targetY - startY) * alpha
        local newPos = Vector3.new(startXZ.X, newY, startXZ.Z)
        ForceHold(CFrame.new(newPos) * rotOnly)
        task.wait(0.016)
    end
    
    local finalCFrame = CFrame.new(Vector3.new(startXZ.X, targetY, startXZ.Z)) * rotOnly
    local lockEnd = tick() + 0.35
    while tick() < lockEnd and (forceMove or Config.AutoFarmActive) do
        ForceHold(finalCFrame)
        task.wait(0.016)
    end
    
    UpdateActivity()
end

function Sf:HoldHeight(targetY, seconds)
    seconds = seconds or 0.4
    local untilTime = tick() + seconds
    while tick() < untilTime and Config.AutoFarmActive do
        local vehicle = Sf:GetOwnedVehicle()
        if vehicle and vehicle.PrimaryPart then
            local pos = vehicle.PrimaryPart.Position
            vehicle:PivotTo(CFrame.new(pos.X, targetY, pos.Z) * (vehicle:GetPivot() - vehicle:GetPivot().Position))
            Sf:UpdateHiddenPlatform(vehicle)
            for _, part in ipairs(vehicle:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.AssemblyLinearVelocity = Vector3.zero
                    part.AssemblyAngularVelocity = Vector3.zero
                end
            end
        elseif RootPart then
            local pos = RootPart.Position
            RootPart.CFrame = CFrame.new(pos.X, targetY, pos.Z) * (RootPart.CFrame - RootPart.CFrame.Position)
        end
        task.wait(0.016)
    end
end

function Sf:RiseDoDescend(surfaceY, actionFn, durationUp, durationDown)
    durationUp = durationUp or 1.1
    -- قريب من النقطة، يبقى تحت، وما ينزل بعد الأمر
    local interactY = (surfaceY or 252) - INTERACT_DROP
    Sf:SmoothVerticalMove(interactY, durationUp)
    Sf:HoldHeight(interactY, 0.35)
    if actionFn then actionFn() end
    Sf:HoldHeight(interactY, 0.45)
    
    local vehicle = Sf:GetOwnedVehicle()
    if vehicle and Humanoid and not Humanoid.Sit then
        Sf:EnterVehicle(vehicle)
    end
end

function Sf:Drive(vehicle, destination, continueCheck)
    if not vehicle or not vehicle.PrimaryPart then return end
    Config.StopWalking = false
    Config.Running = true
    
    -- تحت الأرض ما فيه نافمش، نسوق خط مستقيم على نفس الارتفاع
    if typeof(destination) == "CFrame" then
        destination = destination.Position
    end
    local targetY = destination.Y
    destination = Vector3.new(destination.X, targetY, destination.Z)
    
    Sf:CreateHiddenPlatform(vehicle)
    
    if not Humanoid.Sit then
        Sf:EnterVehicle(vehicle)
        task.wait(0.15)
    end
    
    local goalPos = Vector3.new(destination.X, targetY, destination.Z)
    local speed = Config.VehicleSpeed or 55
    local lookAhead = 16
    local sideStep = 12
    local arriveDist = 4
    local maxTime = 28
    local startTime = tick()
    local lastTick = tick()
    
    local function rayFilter()
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        local filter = {Character}
        if vehicle then table.insert(filter, vehicle) end
        if HiddenPlatform then table.insert(filter, HiddenPlatform) end
        params.FilterDescendantsInstances = filter
        params.IgnoreWater = true
        return params
    end
    
    local function blocked(from, dirFlat, dist)
        if dirFlat.Magnitude < 0.05 then return false end
        local origin = Vector3.new(from.X, targetY, from.Z)
        local hit = workspace:Raycast(origin, dirFlat.Unit * dist, rayFilter())
        return hit ~= nil
    end
    
    while Config.AutoFarmActive and not Config.StopWalking and not isProtectionTriggered do
        task.wait()
        if not vehicle or not vehicle.PrimaryPart then
            Config.Running = false
            return
        end
        if continueCheck and not continueCheck() then break end
        if tick() - startTime > maxTime then break end
        
        if Humanoid and not Humanoid.Sit then
            Sf:EnterVehicle(vehicle)
        end
        
        local now = Vector3.new(vehicle.PrimaryPart.Position.X, targetY, vehicle.PrimaryPart.Position.Z)
        local toGoal = Vector3.new(goalPos.X - now.X, 0, goalPos.Z - now.Z)
        if toGoal.Magnitude <= arriveDist then break end
        
        local dir = toGoal.Unit
        local right = Vector3.new(-dir.Z, 0, dir.X)
        
        -- إذا جدار قدام، نلف يمين أو يسار
        if blocked(now, dir, lookAhead) then
            local leftFree = not blocked(now, dir + right * -1.2, lookAhead)
            local rightFree = not blocked(now, dir + right * 1.2, lookAhead)
            if leftFree and not rightFree then
                dir = (dir * 0.25 + right * -1).Unit
            elseif rightFree and not leftFree then
                dir = (dir * 0.25 + right).Unit
            elseif leftFree or rightFree then
                -- الاثنين فاضي، نختار الأقرب للهدف
                local leftPos = now + right * -sideStep
                local rightPos = now + right * sideStep
                if (leftPos - goalPos).Magnitude < (rightPos - goalPos).Magnitude then
                    dir = (dir * 0.2 + right * -1).Unit
                else
                    dir = (dir * 0.2 + right).Unit
                end
            else
                -- مسدود، نرجع شوي ونحاول جنب أكبر
                dir = (right * ((tick() % 2 < 1) and 1 or -1)).Unit
            end
        end
        
        local nowTick = tick()
        local dt = math.clamp(nowTick - lastTick, 0, 0.05)
        lastTick = nowTick
        local step = math.min(speed * dt, toGoal.Magnitude)
        local newPos = Vector3.new(now.X + dir.X * step, targetY, now.Z + dir.Z * step)
        
        local Rotation = CFrame.new(newPos) * CFrame.Angles(0, math.atan2(dir.X, dir.Z), 0)
        vehicle:PivotTo(Rotation)
        Sf:UpdateHiddenPlatform(vehicle)
        
        for _, part in ipairs(vehicle:GetDescendants()) do
            if part:IsA("BasePart") then
                part.AssemblyLinearVelocity = Vector3.zero
                part.AssemblyAngularVelocity = Vector3.zero
            end
        end
    end
    
    Config.Running = false
    UpdateActivity()
end

function Sf:WalkTo(destination, continueCheck, speed)
    if isProtectionTriggered then return end
    Config.StopWalking = false
    Config.Running = true
    
    local path = PathfindingService:CreatePath({
        AgentCanJump = true, AgentJumpHeight = 2.5, AgentHeight = 8, AgentRadius = 2.5, AgentMaxSlope = 90,
        Costs = {BlockedNode = 50, DoorArea = 1}
    })
    
    local success = pcall(function() path:ComputeAsync(RootPart.Position, destination) end)
    if not success or path.Status ~= Enum.PathStatus.Success then
        Config.Running = false
        return
    end
    
    local waypoints = path:GetWaypoints()
    speed = speed or Config.WalkSpeed or 20
    
    for _, wp in pairs(waypoints) do
        if isProtectionTriggered or not Config.AutoFarmActive or Config.StopWalking then
            Config.Running = false
            return
        end
        if continueCheck and not continueCheck() then
            Config.Running = false
            return
        end
        
        local offsetY = (wp.Action == Enum.PathWaypointAction.Jump) and 10 or 4
        local targetPos = wp.Position + Vector3.new(0, offsetY, 0)
        local startPos = RootPart.Position
        local dir = (targetPos - startPos).Unit
        local dist = (targetPos - startPos).Magnitude
        local movedDist = 0
        local startTime = tick()
        
        while movedDist < dist and Config.AutoFarmActive and not Config.StopWalking and not isProtectionTriggered do
            task.wait()
            if Humanoid.Health <= 0 then break end
            if continueCheck and not continueCheck() then break end
            
            local elapsed = tick() - startTime
            movedDist = math.min(elapsed * speed, dist)
            local newPos = startPos + dir * movedDist
            if Humanoid.Sit then Humanoid.Sit = false end
            RootPart:PivotTo(CFrame.new(newPos))
            pcall(function() Net.send("set_sprinting_1", true) end)
        end
    end
    Config.Running = false
    UpdateActivity()
end

function Sf:SmartMoveTo(destination, continueCheck)
    if not Config.AutoFarmActive or isProtectionTriggered then return end
    
    -- نقاط السطح (بيع/دكان/صراف) ننزلها، نقطة المنطقة تبقى بنفس ارتفاعها بالزبط
    if destination.Y > 245 then
        destination = UnderPos(destination)
    end
    
    local maxTime = 40
    local startTime = tick()
    
    local function stillOk()
        return Config.AutoFarmActive and not isProtectionTriggered and (tick() - startTime) < maxTime
    end
    
    Character = Client.Character
    Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
    RootPart = Character and Character:FindFirstChild("HumanoidRootPart")
    
    local vehicle = Sf:EnsureVehicle()
    if vehicle then
        Sf:CreateHiddenPlatform(vehicle)
        
        if Humanoid and not Humanoid.Sit then
            Sf:EnterVehicle(vehicle)
            task.wait(0.15)
        end
        
        if stillOk() then
            Sf:Drive(vehicle, destination, function()
                return stillOk() and (continueCheck and continueCheck() or true)
            end)
            return
        end
    end
end

