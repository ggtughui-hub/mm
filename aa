function Sf:GetTotalLevel()
    local ok, level = pcall(function()
        if Data_upvr and Data_upvr.xp and Data_upvr.xp.total_level and XPFormula_upvr then
            return XPFormula_upvr.xp_to_level(Data_upvr.xp.total_level) or 0
        end
        return 0
    end)
    return (ok and level) or 0
end

-- نظام المخزون: أقل من total level 8 = 15 سلوت، 8 فأكثر = 17
function Sf:IsInventoryFull()
    local totalLevel = self:GetTotalLevel() or 0
    local maxSlots = 15
    if totalLevel >= 8 then
        maxSlots = 17
    end

    local currentCount = 0
    local counted = false
    if ItemUtils and Data_upvr then
        local ok = pcall(function()
            ItemUtils.iterate_through_items(Data_upvr, function(item)
                if item and item.location == "hand" then
                    currentCount = currentCount + 1
                end
            end)
            counted = true
        end)
        if not ok then counted = false end
    end
    if not counted then
        currentCount = self:GetInventoryCount()
    end

    local isFull = currentCount >= maxSlots
    return isFull, currentCount, maxSlots
end

