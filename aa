-- زر Hop Server
local HopBtn = Instance.new("TextButton")
HopBtn.Size = UDim2.new(1, -20, 0, 30)
HopBtn.Position = UDim2.new(0, 10, 0, 65)
HopBtn.BackgroundColor3 = Color3.fromRGB(45, 45, 60)
HopBtn.Text = "🔄 Hop Server"
HopBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
HopBtn.TextSize = 12
HopBtn.Font = Enum.Font.GothamBold
HopBtn.Parent = MainFrame

local HopCorner = Instance.new("UICorner")
HopCorner.CornerRadius = UDim.new(0, 6)
HopCorner.Parent = HopBtn

HopBtn.MouseButton1Click:Connect(function()
    HopBtn.Text = "جاري البحث..."
    pcall(function()
        local servers = {}
        local req = game:HttpGet("https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100")
        local decoded = HttpService:JSONDecode(req)
        
        if decoded and decoded.data then
            for _, srv in pairs(decoded.data) do
                if srv.playing < srv.maxPlayers and srv.id ~= game.JobId then
                    table.insert(servers, srv.id)
                end
            end
        end
        
        if #servers > 0 then
            HopBtn.Text = "جاري الانتقال..."
            local targetServer = servers[math.random(1, #servers)]
            queueAndTeleport(targetServer)
        else
            HopBtn.Text = "مافي سيرفرات!"
            task.wait(2)
            HopBtn.Text = "🔄 Hop Server"
        end
    end)
end)

