local function IsValidPot(pot)
    if not pot then return false end
    local lowerName = string.lower(tostring(pot.Name))
    if string.find(lowerName, "template") or string.find(lowerName, "clone")
        or string.find(lowerName, "fake") or string.find(lowerName, "preview")
        or string.find(lowerName, "hidden") or string.find(lowerName, "ghost") then
        return false
    end

    local part = nil
    if pot:IsA("Model") then
        part = pot.PrimaryPart or pot:FindFirstChildWhichIsA("BasePart")
    elseif pot:IsA("BasePart") then
        part = pot
    end
    if not part then return false end

    local pos = part.Position
    -- أسطل وهمية/مخفية غالباً على Y غلط أو عند الصفر
    if (pos.X == 0 and pos.Y == 0 and pos.Z == 0) then return false end
    if pos.Y < 200 or pos.Y > 320 then return false end

    local hasPrompt = false
    for _, desc in ipairs(pot:GetDescendants()) do
        if desc:IsA("ProximityPrompt") then
            hasPrompt = true
            break
        end
    end
    if not hasPrompt then
        local p = part:FindFirstChildWhichIsA("ProximityPrompt", true)
        if p then hasPrompt = true end
    end
    if not hasPrompt then return false end

    -- لازم يكون فيه جزء ظاهر بحجم حقيقي (مو سطل مخفي)
    local hasSolid = false
    for _, desc in ipairs(pot:GetDescendants()) do
        if desc:IsA("BasePart") and desc.Transparency < 1 and desc.Size.Magnitude > 1 then
            hasSolid = true
            break
        end
    end
    if not hasSolid and part.Transparency < 1 and part.Size.Magnitude > 1 then
        hasSolid = true
    end
    return hasSolid
end

local function GetPlantTime(pot)
    for _, desc in ipairs(pot:GetDescendants()) do
        if desc:IsA("TextLabel") then
            local txt = desc.Text or ""
            local lowerTxt = string.lower(txt)
            if string.find(lowerTxt, "done") or string.find(lowerTxt, "ready") or string.find(lowerTxt, "harvest") then
                return "جاهز للحصاد!"
            end
            local timeMatch = string.match(txt, "%d+:%d+")
            if timeMatch and timeMatch ~= "00:00" then
                return timeMatch
            end
        end
    end
    return nil
end

local function GetPotState(pot)
    local hasSoil, hasPlant = false, false
    for _, child in ipairs(pot:GetDescendants()) do
        if child.Name == "RegularSoil" then hasSoil = true end
        if string.match(tostring(child.Name), "Stage%d+Sunflower") or child.Name == "Sunflower" then
            hasPlant = true
            hasSoil = true
        end
    end
    if not hasSoil then
        return "فارغ"
    elseif hasSoil and not hasPlant then
        return "تربة فقط"
    else
        local t = GetPlantTime(pot)
        if t == "جاهز للحصاد!" then
            return "جاهز للحصاد"
        end
        return "تربة وزرع"
    end
end

