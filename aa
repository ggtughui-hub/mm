function Sf:IsATMAvailable(atm)
    if not atm or not atm.Parent then return false end
    local ok, available = pcall(function()
        if not atm:FindFirstChild("Area") then return false end
        local keys = {}
        for k in pairs(atm:GetAttributes()) do table.insert(keys, k) end
        table.sort(keys)
        -- إذا attribute الثالث true = متهكرة/مشغولة
        if keys[3] and atm:GetAttribute(keys[3]) == true then
            return false
        end
        return true
    end)
    return ok and available == true
end

function Sf:FindClosestAvailableATM(excludeAtm)
    local success, result = pcall(function()
        local atmFolder = workspace:FindFirstChild("Map") and workspace.Map:FindFirstChild("Props") and workspace.Map.Props:FindFirstChild("ATMs")
        if not atmFolder then return nil end
        local closestAvail, shortestAvail = nil, math.huge
        for _, atm in pairs(atmFolder:GetChildren()) do
            if atm ~= excludeAtm and atm.Name == "ATM" and atm:IsA("Model") and atm:FindFirstChild("Area") then
                if Sf:IsATMAvailable(atm) then
                    local d = Sf:dist(atm.Area.Position)
                    if d < shortestAvail then
                        closestAvail = atm
                        shortestAvail = d
                    end
                end
            end
        end
        return closestAvail
    end)
    return success and result or nil
end

