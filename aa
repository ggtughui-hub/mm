local function GetMyHouse()
    local mapFolder = workspace:FindFirstChild("Map")
    if not mapFolder then return nil end
    local tiles = mapFolder:FindFirstChild("Tiles")
    if not tiles then return nil end
    for _, tile in ipairs(tiles:GetChildren()) do
        for _, subTile in ipairs(tile:GetChildren()) do
            for _, obj in ipairs(subTile:GetChildren()) do
                if obj:IsA("Model") then
                    local isHouse = false
                    for _, name in ipairs(houseNames) do
                        if obj.Name == name then isHouse = true break end
                    end
                    if isHouse then
                        if obj:GetAttribute("Owner") == Client.Name or obj:GetAttribute("Owner") == Client then
                            return obj
                        end
                        for _, child in ipairs(obj:GetChildren()) do
                            if (child:IsA("StringValue") or child:IsA("ObjectValue")) and (child.Value == Client.Name or child.Value == Client) then
                                return obj
                            end
                        end
                    end
                end
            end
        end
    end
    return nil
end

local function IsMyHouse(houseObject)
    if not houseObject then return false end
    for _, name in ipairs(houseNames) do
        if houseObject.Name == name then
            if houseObject:GetAttribute("Owner") == Client.Name or houseObject:GetAttribute("Owner") == Client then
                return true
            end
            for _, child in ipairs(houseObject:GetChildren()) do
                if (child:IsA("StringValue") or child:IsA("ObjectValue")) and (child.Value == Client.Name or child.Value == Client) then
                    return true
                end
            end
        end
    end
    return false
end

