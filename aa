-- [ ضع هنا رابط السكربت الخاص بك الأساسي (Raw Link) لكي يستدعيه بعد الريجون والهوب ]
local MyScriptLink = "رابط_السكربت_الخاص_بك_هنا.lua" 

-- دالة حفظ واستدعاء السكربت تلقائياً عند الانتقال
local function queueAndTeleport(targetServerId)
    local QueueFunction = queue_on_teleport or (syn and syn.queue_on_teleport) or queueonteleport
    if QueueFunction then
        -- أمر حقن السكربت الأساسي ليعمل مباشرة في السيرفر القادم
        QueueFunction('loadstring(game:HttpGet("' .. MyScriptLink .. '"))()')
    end
    
    if targetServerId then
        TeleportService:TeleportToPlaceInstance(game.PlaceId, targetServerId, LocalPlayer)
    else
        TeleportService:Teleport(game.PlaceId, LocalPlayer)
    end
end

