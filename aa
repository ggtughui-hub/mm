local function CollectMyPots()
    local myPots = {}
    local seen = {}
    local mapFolder = workspace:FindFirstChild("Map")
    if not (mapFolder and mapFolder:FindFirstChild("Tiles")) then return myPots end

    for _, tile in ipairs(mapFolder.Tiles:GetChildren()) do
        for _, subTile in ipairs(tile:GetChildren()) do
            local house = nil
            for _, name in ipairs(houseNames) do
                house = subTile:FindFirstChild(name)
                if house then break end
            end
            if not (house and IsMyHouse(house)) then
                -- continue
            else
                -- موقع البيت عشان نرفض أسطل بعيدة/وهمية
                local housePos = nil
                pcall(function()
                    local hp = house.PrimaryPart or house:FindFirstChildWhichIsA("BasePart")
                    if hp then housePos = hp.Position end
                end)

                local folder = subTile:FindFirstChild("FarmingPots")
                if not folder then
                    folder = house:FindFirstChild("FarmingPots", true)
                end
                if folder then
                    for _, pot in ipairs(folder:GetChildren()) do
                        if (pot:IsA("Model") or pot:IsA("BasePart")) and IsValidPot(pot) then
                            local part = pot:IsA("Model") and (pot.PrimaryPart or pot:FindFirstChildWhichIsA("BasePart")) or pot
                            if part then
                                -- لازم قريب من البيت (مو سطل مخفي بعيد)
                                local nearHouse = true
                                if housePos then
                                    local d = (Vector3.new(part.Position.X, 0, part.Position.Z) - Vector3.new(housePos.X, 0, housePos.Z)).Magnitude
                                    if d > 80 then
                                        nearHouse = false
                                    end
                                end
                                if nearHouse then
                                    local key = string.format("%.0f_%.0f_%.0f", part.Position.X, part.Position.Y, part.Position.Z)
                                    if not seen[key] then
                                        seen[key] = true
                                        table.insert(myPots, pot)
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    print("🪴 أسطل حقيقية: " .. tostring(#myPots))
    return myPots
end

-- دورة زراعة كاملة (حصاد + تربة + بذور) ثم يرجع
local function DoPotsCycle()
    if isDoingPots or not Config.AutoFarmActive or isProtectionTriggered then return false end
    isDoingPots = true
    local didSomething = false

    pcall(function()
        -- اترك السنارة قبل الزراعة
        UnequipAllTools()

        local myHouse = GetMyHouse()
        if not myHouse then
            print("🏠 استئجار بيت...")
            myHouse = RentHouseIfNeeded()
            if not myHouse then
                return
            end
            didSomething = true
        end

        local myPots = CollectMyPots()
        if #myPots == 0 then
            return
        end

        local emptyPots, soilOnlyPots, readyPots = {}, {}, {}
        local stillGrowing = 0
        for _, pot in ipairs(myPots) do
            local st = GetPotState(pot)
            if st == "فارغ" then
                table.insert(emptyPots, pot)
            elseif st == "تربة فقط" then
                table.insert(soilOnlyPots, pot)
            elseif st == "جاهز للحصاد" then
                table.insert(readyPots, pot)
            else
                stillGrowing = stillGrowing + 1
            end
        end

        print("🌱 فحص: جاهز=" .. #readyPots .. " ينمو=" .. stillGrowing .. " فارغ=" .. #emptyPots .. " تربة=" .. #soilOnlyPots .. " / إجمالي=" .. #myPots)

        -- حصاد فقط إذا كل الأسطل جاهزة (ما في ولا واحد ينمو)
        if #readyPots > 0 and stillGrowing == 0 and #emptyPots == 0 and #soilOnlyPots == 0 then
            print("🌾 كل الأسطل جاهزة (" .. #readyPots .. ") — بدء الحصاد")
            for _, pot in ipairs(readyPots) do
                if not Config.AutoFarmActive or isProtectionTriggered then break end
                local part = pot:IsA("Model") and (pot.PrimaryPart or pot:FindFirstChildWhichIsA("BasePart")) or pot
                if part then
                    PotsInteract(part.Position, function()
                        local prompt = part:FindFirstChildWhichIsA("ProximityPrompt", true)
                        if prompt then
                            fireproximityprompt(prompt)
                            task.wait(0.12)
                        end
                    end)
                    didSomething = true
                end
            end
            task.wait(0.4)
            myPots = CollectMyPots()
            emptyPots, soilOnlyPots, readyPots = {}, {}, {}
            stillGrowing = 0
            for _, pot in ipairs(myPots) do
                local st = GetPotState(pot)
                if st == "فارغ" then table.insert(emptyPots, pot)
                elseif st == "تربة فقط" then table.insert(soilOnlyPots, pot)
                elseif st == "جاهز للحصاد" then table.insert(readyPots, pot)
                else stillGrowing = stillGrowing + 1 end
            end
        elseif #readyPots > 0 and stillGrowing > 0 then
            print("⏳ جاهز=" .. #readyPots .. " لكن باقي " .. stillGrowing .. " ينمو — انتظار الكل")
            return
        end

        local needsSoil = #emptyPots
        local needsSeeds = #emptyPots + #soilOnlyPots

        if needsSoil == 0 and needsSeeds == 0 then
            return
        end

        local currentSoil = GetItemCount("RegularSoil")
        local currentSeeds = GetItemCount("SunflowerSeeds")
        local soilToBuy = math.max(0, needsSoil - currentSoil)
        local seedsToBuy = math.max(0, needsSeeds - currentSeeds)
        soilToBuy = math.min(soilToBuy, needsSoil)
        seedsToBuy = math.min(seedsToBuy, needsSeeds)

        print("🛒 تربة: عندك=" .. currentSoil .. " تحتاج=" .. needsSoil .. " شراء=" .. soilToBuy)
        print("🛒 بذور: عندك=" .. currentSeeds .. " تحتاج=" .. needsSeeds .. " شراء=" .. seedsToBuy)

        if soilToBuy > 0 or seedsToBuy > 0 then
            local cost = (soilToBuy * 350) + (seedsToBuy * 190)
            if cost > 0 and Sf:GetMoney() < cost then
                pcall(function()
                    if Sf:GetBankMoney() >= (cost - Sf:GetMoney() + 5) then
                        WithdrawSpecificAmount(cost + 10)
                    end
                end)
            end

            local shopPos = Vector3.new(-135.7, 255.6, 153.3)
            PotsInteract(shopPos, function()
                task.wait(0.15)
                for i = 1, soilToBuy do
                    if not Config.AutoFarmActive then break end
                    pcall(function()
                        Net.get("purchase_consumable", workspace:FindFirstChild("ShopZone_Hardware"), "RegularSoil")
                    end)
                    task.wait(0.05)
                end
                for i = 1, seedsToBuy do
                    if not Config.AutoFarmActive then break end
                    pcall(function()
                        Net.get("purchase_consumable", workspace:FindFirstChild("ShopZone_Hardware"), "SunflowerSeeds")
                    end)
                    task.wait(0.05)
                end
                task.wait(0.25)
            end)
            didSomething = true
        end

        -- جهّز التربة مرة واحدة قبل اللفة
        if #emptyPots > 0 then
            EquipItemFromInventory("RegularSoil")
            task.wait(0.2)
        end
        for _, pot in ipairs(emptyPots) do
            if not Config.AutoFarmActive or isProtectionTriggered then break end
            if GetPotState(pot) == "فارغ" then
                -- تأكد التربة باليد قبل ما نوصل
                if not (Character and Character:FindFirstChild("RegularSoil")) then
                    EquipItemFromInventory("RegularSoil")
                    task.wait(0.15)
                end
                local part = pot:IsA("Model") and (pot.PrimaryPart or pot:FindFirstChildWhichIsA("BasePart")) or pot
                if part and Character and Character:FindFirstChild("RegularSoil") then
                    PotsInteract(part.Position, function()
                        -- قبل البرومبت: تأكد مرة أخيرة التربة باليد مو السنارة
                        if not (Character and Character:FindFirstChild("RegularSoil")) then
                            EquipItemFromInventory("RegularSoil")
                            task.wait(0.12)
                        end
                        if Character and Character:FindFirstChild("RegularSoil") then
                            local prompt = part:FindFirstChildWhichIsA("ProximityPrompt", true)
                            if prompt then
                                fireproximityprompt(prompt)
                                task.wait(0.2)
                                fireproximityprompt(prompt)
                                task.wait(0.15)
                            end
                        else
                            print("⚠️ التربة مو باليد لحظة الزراعة")
                        end
                    end)
                    didSomething = true
                else
                    print("⚠️ ما قدرت أجهّز RegularSoil — تخطي سطل")
                end
            end
        end

        myPots = CollectMyPots()
        soilOnlyPots = {}
        for _, pot in ipairs(myPots) do
            if GetPotState(pot) == "تربة فقط" then
                table.insert(soilOnlyPots, pot)
            end
        end

        if #soilOnlyPots > 0 then
            EquipItemFromInventory("SunflowerSeeds")
            task.wait(0.2)
        end
        for _, pot in ipairs(soilOnlyPots) do
            if not Config.AutoFarmActive or isProtectionTriggered then break end
            if GetPotState(pot) == "تربة فقط" then
                if not (Character and Character:FindFirstChild("SunflowerSeeds")) then
                    EquipItemFromInventory("SunflowerSeeds")
                    task.wait(0.15)
                end
                local part = pot:IsA("Model") and (pot.PrimaryPart or pot:FindFirstChildWhichIsA("BasePart")) or pot
                if part and Character and Character:FindFirstChild("SunflowerSeeds") then
                    PotsInteract(part.Position, function()
                        if not (Character and Character:FindFirstChild("SunflowerSeeds")) then
                            EquipItemFromInventory("SunflowerSeeds")
                            task.wait(0.12)
                        end
                        if Character and Character:FindFirstChild("SunflowerSeeds") then
                            local prompt = part:FindFirstChildWhichIsA("ProximityPrompt", true)
                            if prompt then
                                fireproximityprompt(prompt)
                                task.wait(0.2)
                                fireproximityprompt(prompt)
                                task.wait(0.15)
                            end
                        else
                            print("⚠️ البذور مو باليد لحظة الزراعة")
                        end
                    end)
                    didSomething = true
                else
                    print("⚠️ ما قدرت أجهّز SunflowerSeeds — تخطي سطل")
                end
            end
        end
    end)

    isDoingPots = false
    Config.LastPotsCheck = tick()
    return didSomething
end

-- ============================================================
function StartAutoFarm()
    if farmLoopRunning then return end
    farmLoopRunning = true
    
    -- إبقاء السنارة مجهزة (يتوقف أثناء الزراعة)
    task.spawn(function()
        while Config.AutoFarmActive do
            if not isDoingPots then
                pcall(function()
                    local char = Client.Character or Client.CharacterAdded:Wait()
                    local backpack = Client:FindFirstChild("Backpack")
                    local humanoid = char:FindFirstChildOfClass("Humanoid")
                    local toolNames = {"FishingRodUltimate", "FishingRodAdvanced", "FishingRodPro", "FishingRodRegular"}
                    if backpack and humanoid then
                        local mainTool = nil
                        for _, name in ipairs(toolNames) do
                            mainTool = char:FindFirstChild(name) or backpack:FindFirstChild(name)
                            if mainTool then break end
                        end
                        if mainTool and mainTool.Parent == backpack then
                            humanoid:EquipTool(mainTool)
                        end
                    end
                end)
            end
            task.wait(0.5)
        end
    end)

    -- 1) رسبن المركبة واركبها على السطح أولاً
    if Config.UseVehicle then
        local vehicle = Sf:RespawnAndMountVehicle()
        if not vehicle then
            vehicle = Sf:EnsureVehicle()
            if vehicle then
                Sf:EnterVehicle(vehicle)
                task.wait(0.15)
            end
        end
        if not Config.AutoFarmActive then farmLoopRunning = false return end
    end

    EquipRod()
    if not Config.AutoFarmActive then farmLoopRunning = false return end

    -- 2) ننزل تحت أولاً، بعدين شراء/إيداع عشان ما يطلع للصراف فوق
    if Config.UseVehicle then
        local vehicle = Sf:GetOwnedVehicle()
        if vehicle and not Humanoid.Sit then
            Sf:EnterVehicle(vehicle)
            task.wait(0.12)
        end
        if vehicle then
            Sf:CreateHiddenPlatform(vehicle)
        end
    end
    Sf:SmoothVerticalMove(UNDERGROUND_Y, 0.85)
    task.wait(0.08)

    -- زراعة أول مرة قبل الصيد
    if Config.AutoFarmPots then
        pcall(function()
            print("🌱 فحص الزراعة أول مرة...")
            DoPotsCycle()
        end)
        task.wait(0.2)
        -- تأكد نرجع تحت بعد الزراعة
        pcall(function()
            local vehicle = Sf:GetOwnedVehicle()
            if vehicle and vehicle.PrimaryPart then
                Sf:SmoothVerticalMove(UNDERGROUND_Y, 0.5)
            end
        end)
    end

    if Config.AutoBuyEnabled then
        local hasRodStart = select(1, Sf:HasAnyRod())
        local hasBaitStart = select(1, Sf:HasAnyBait())
        if not (hasRodStart and hasBaitStart) then
            BuyEquipment()
            if not Config.AutoFarmActive then farmLoopRunning = false return end
        end
    end

    while Config.AutoFarmActive do
        if not Client.Character or not Client.Character.Parent then
            task.wait(1)
            continue
        end
        
        Character = Client.Character
        Humanoid = Character:FindFirstChildOfClass("Humanoid")
        RootPart = Character:FindFirstChild("HumanoidRootPart")

        if isProtectionTriggered then
            while isProtectionTriggered and Config.AutoFarmActive do task.wait(0.4) end
            if not Config.AutoFarmActive then break end
            continue
        end

        -- ===== زراعة تلقائية (كل فترة أو أول تشغيل) =====
        if Config.AutoFarmPots and not isDoingPots then
            local needPotsNow = (tick() - (Config.LastPotsCheck or 0)) >= (Config.PotsCheckInterval or 45)
            if needPotsNow or (Config.LastPotsCheck or 0) == 0 then
                local didPots = false
                pcall(function()
                    didPots = DoPotsCycle()
                end)
                if didPots and Config.AutoFarmActive then
                    -- رجع لمنطقة الصيد بعد الزراعة
                    local zdata = Zones[Config.ZoneSelect]
                    if zdata then
                        pcall(function()
                            Sf:SmartMoveTo(zdata.Pos)
                            Sf:SmoothVerticalMove(zdata.Pos.Y, 0.4)
                        end)
                    end
                    EquipRod()
                    EquipBaitOnRod()
                end
            end
        end
        if isDoingPots then
            task.wait(0.3)
            continue
        end

        EnsureRodEquipped()

        local zone = Config.ZoneSelect
        local data = Zones[zone]
        if not data then task.wait(1); continue end

        local isFull, inventoryCount, maxSlots = Sf:IsInventoryFull()
        local hasBait = Sf:HasAnyBait()
        if inventoryCount == 0 then
            task.wait(0.08)
            isFull, inventoryCount, maxSlots = Sf:IsInventoryFull()
            hasBait = Sf:HasAnyBait()
        end
        
        -- === منطق البيع والشراء ===
        -- بيع إذا الإنفنتوري ممتلئ (15 أو 17 حسب التوتال لفل) أو ما فيه طعم ومعك أسماك
        local fishCount = Sf:GetFishCount()
        local needSell = isFull or ((not hasBait) and fishCount > 0)
        if needSell then
            if fishCount > 0 then
                Sf:SellFishWithPath()
                task.wait(0.6)
                if Sf:GetFishCount() > 0 then
                    Sf:SellFishWithPath()
                    task.wait(0.4)
                end
            end
            
            DepositAllMoney()
            task.wait(0.4)
            
            if not Config.AutoFarmActive then break end
            
            hasBait = Sf:HasAnyBait()
            if not hasBait then
                if Config.AutoBuyEnabled then
                    BuyEquipment()
                    if not Config.AutoFarmActive then break end
                    EquipRod()
                    task.wait(0.3)
                end
            end
            
            isFull, inventoryCount, maxSlots = Sf:IsInventoryFull()
            hasBait = Sf:HasAnyBait()
        end

        -- إذا التسكيب خلّى الطعم يخلص وما فيه سمك للبيع، روح اشترِ مباشرة
        if Config.AutoFarmActive and Config.AutoBuyEnabled then
            local hasRodNow = select(1, Sf:HasAnyRod())
            hasBait = Sf:HasAnyBait()
            if (not hasBait) or (not hasRodNow) then
                BuyEquipment()
                if not Config.AutoFarmActive then break end
                EquipRod()
                EquipBaitOnRod()
                task.wait(0.3)
                hasBait = Sf:HasAnyBait()
                isFull, inventoryCount, maxSlots = Sf:IsInventoryFull()
            end
        end

        -- === منطق الصيد ===
        if Config.AutoFarmActive and (not isFull) and hasBait then
            local zonePos = data.Pos
            local myPos = RootPart and RootPart.Position or zonePos
            local distToZone = (Vector3.new(myPos.X, 0, myPos.Z) - Vector3.new(zonePos.X, 0, zonePos.Z)).Magnitude
            
            -- نروح للمنطقة فقط لو بعيدين فعلياً (ما نتحرك بعد كل رمية)
            if distToZone > 55 then
                Sf:SmartMoveTo(data.Pos)
                task.wait(0.12)
            end
            
            -- نثبت ارتفاع منطقة 70 بالزبط
            local veh = Sf:GetOwnedVehicle()
            local holdPart = (veh and veh.PrimaryPart) or RootPart
            if holdPart and math.abs(holdPart.Position.Y - data.Pos.Y) > 2 then
                Sf:SmoothVerticalMove(data.Pos.Y, 0.35)
            end
            
            if isProtectionTriggered then continue end
            if not Sf:HasAnyBait() then continue end
            
            EnsureRodEquipped()

            -- نتأكد إننا راكبين (ما ننزل أبداً لو راكبين)
            if Config.UseVehicle then
                local vehicle = Sf:GetOwnedVehicle()
                if vehicle and not Humanoid.Sit then
                    Sf:EnterVehicle(vehicle)
                    task.wait(0.08)
                end
            end

            EquipBaitOnRod()
            task.wait(0.05)

            local castPos
            if zone == "Level 70 +" and Zones["Level 70 +"].CastPositions then
                local positions = Zones["Level 70 +"].CastPositions
                castPos = positions[math.random(1, #positions)]
            else
                local offset = Vector3.new(math.random(-45, -8), 0, math.random(-18, 18))
                castPos = RootPart.Position + offset
            end
            
            -- وقت الصيد ما نحرّك السيكل أبداً (هذا كان سبب الاهتزاز والتقدم)

            local hasRod, rodName = Sf:HasAnyRod()
            local rodTool = nil
            if hasRod and rodName then
                rodTool = Character:FindFirstChild(rodName) or Backpack:FindFirstChild(rodName)
            end
            
            -- فحص نهائي قبل الرمي: إذا المخزون ممتلئ لا ترمي
            local finalFull, finalCnt, finalMax = Sf:IsInventoryFull()
            if finalFull or (finalCnt and finalMax and finalCnt >= finalMax) then
                -- لا ترمي، الحلقة الرئيسية تبيع
            elseif rodTool then
                pcall(function() Net.get("throw_rod", rodTool, castPos) end)
            else
                pcall(function() VU:ClickButton1(Vector2.new(500, 300)) end)
            end
            
            UpdateActivity()

            local timeout = tick() + 25
            local progressBarVisible = false
            
            while Config.AutoFarmActive and tick() < timeout and not isProtectionTriggered do
                task.wait(0.1)
                if isSliderOpen() then
                    progressBarVisible = true
                    UpdateActivity()
                    break
                end
            end

            if isProtectionTriggered then continue end

            local keptThisCatch = false
            if progressBarVisible then
                local sliderSeenAt = tick()
                local skippedThisCatch = false
                while Config.AutoFarmActive and isSliderOpen() and not isProtectionTriggered do
                    local hooked = getHookedFishName()
                    local elapsed = tick() - sliderSeenAt
                    if isSkipTarget(hooked) then
                        if elapsed >= skipDelay and not isSkippingFish then
                            skippedThisCatch = doSkipHookedFish(hooked, true)
                            break
                        end
                    elseif elapsed >= 1.3 and not isSkippingFish then
                        QuickWin()
                        if rodTool then
                            pcall(function() Net.send("reel_ended", rodTool, true) end)
                        end
                        keptThisCatch = true
                        break
                    end
                    task.wait(0.05)
                end
                UpdateActivity()
                task.wait(0.18)
            else
                local hooked = getHookedFishName()
                if isSkipTarget(hooked) and not isSkippingFish then
                    doSkipHookedFish(hooked, false)
                elseif rodTool then
                    pcall(function() Net.send("reel_ended", rodTool, false) end)
                end
            end

            if keptThisCatch and Config.AutoFarmActive and not isDoingPots then
                -- انتظر السمكة تدخل الإنفنتوري ثم بيع مباشرة
                local waitFish = 0
                while waitFish < 1.2 and Sf:GetFishCount() == 0 and Config.AutoFarmActive do
                    task.wait(0.1)
                    waitFish = waitFish + 0.1
                end
                if Sf:GetFishCount() > 0 then
                    print("💰 سمكة محفوظة — بيع مباشر ثم رجوع للصيد")
                    Sf:SellFishWithPath()
                    task.wait(0.3)
                    if Config.AutoFarmActive and Zones[Config.ZoneSelect] then
                        Sf:SmartMoveTo(Zones[Config.ZoneSelect].Pos)
                        Sf:SmoothVerticalMove(Zones[Config.ZoneSelect].Pos.Y, 0.35)
                    end
                    EnsureRodEquipped()
                    EquipBaitOnRod()
                end
            end
            
            -- تأكد إننا ما نعلق بعد الرمية: ثبت الارتفاع وكمّل
            if Config.UseVehicle then
                local vehicle = Sf:GetOwnedVehicle()
                if vehicle and vehicle.PrimaryPart and Humanoid and not Humanoid.Sit then
                    Sf:EnterVehicle(vehicle)
                end
            end
            local zoneData = Zones[Config.ZoneSelect]
            if zoneData and RootPart then
                local holdPart = RootPart
                local veh2 = Sf:GetOwnedVehicle()
                if veh2 and veh2.PrimaryPart then holdPart = veh2.PrimaryPart end
                if holdPart and math.abs(holdPart.Position.Y - zoneData.Pos.Y) > 4 then
                    Sf:SmoothVerticalMove(zoneData.Pos.Y, 0.25)
                end
            end
        end
        
        task.wait(0.08)
    end
    farmLoopRunning = false
end

pcall(function() EnableAntiKick(true) end)

